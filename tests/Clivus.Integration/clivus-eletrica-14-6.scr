; Nivel 2 do 14.6 (eletrica): dois inversores em campo (Z do clique absurdo);
; o Inversor 1 e posto de novo (move) e renomeado: a tag no topo acompanha.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "2")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 1" "{{P1}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "inversor 2" "{{P2}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 1" "{{P3}}")
(command "CLIVUS_ELETRICA_AUTO" "EditarInversor" "Inversor 1" "INV-A" "Huawei 250")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(defun clivus:tag (bloco / e d txt)
  (setq e (tblobjname "BLOCK" bloco) txt "?")
  (while (setq e (entnext e))
    (setq d (entget e))
    (if (= (cdr (assoc 0 d)) "MTEXT") (setq txt (cdr (assoc 1 d)))))
  txt)
(defun clivus:equip ( / ss i e d x p)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (list -3 (list "CLIVUS")))) i 0)
  (if ss
    (while (< i (sslength ss))
      (setq e (ssname ss i) d (entget e (list "CLIVUS")) x (cdr (cadr (assoc -3 d))) p (cdr (assoc 10 d)) i (1+ i))
      (if (= (cdr (car x)) "Equipamento")
        (princ (strcat "\nCLIVUS_EQUIP tipo=" (cdr (nth 2 x)) " x=" (rtos (car p) 2 3) " y=" (rtos (cadr p) 2 3) " z=" (rtos (caddr p) 2 3)
                       " layer=" (cdr (assoc 8 d)) " bloco=" (cdr (assoc 2 d)) " fim tag=" (clivus:tag (cdr (assoc 2 d))) " /tag")))))
  (princ))
(clivus:equip)
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
