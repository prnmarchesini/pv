; Nivel 2 do 11.2 (eletrica): escolher as mesas de um tipo de string em
; campo. Usina pelo motor (mesas de 28 e de 14) e strings de teste; a selecao
; leva junto uma string e uma linha solta, que tem que ficar de fora (so mesa
; entra). Uma mesa, duas vizinhas da mesma fileira, duas de fileiras
; diferentes (recusado) e so a linha (nenhuma mesa).
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "_.LINE" "{{A1}}" "{{A3}}" "")
(setq clivus:linha (entlast))
(setvar "OSMODE" clivus:osmode)
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:mesa (rotulo / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (cdr (nth 0 xd)) "Mesa") (= (cdr (nth 3 xd)) rotulo)) (setq achada e))
    (setq i (1+ i)))
  achada)
(defun clivus:junta (lista / ss) (setq ss (ssadd)) (foreach e lista (if e (ssadd e ss))) ss)
(setq clivus:string (ssname (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING"))) 0))
(princ (strcat "\nCLIVUS_ACHADAS F1.1=" (if (clivus:mesa "F1.1") "sim" "nao") " F1.2=" (if (clivus:mesa "F1.2") "sim" "nao") " F2.1=" (if (clivus:mesa "F2.1") "sim" "nao")))
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:mesa "F1.1") clivus:string clivus:linha)) "")
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:mesa "F1.2") (clivus:mesa "F1.1"))) "")
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:mesa "F1.1") (clivus:mesa "F2.1"))) "")
(command "CLIVUS_STRING_MESAS" (clivus:junta (list clivus:linha clivus:string)) "")
(command "CLIVUS_STRING_TIPO_AUTO" "Listar")
(princ "\nCLIVUS_STRING_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
