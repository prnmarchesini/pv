; Nivel 2 da tabela de inversores da aba Inversor (05/10/2026): a potencia do
; modelo (formato 3; o 2 sem potencia lido com 0), o trafo de cada inversor pela
; caixa da linha e pelo "Por no trafo" (o mesmo caminho da janela, fora de
; comando) e as colunas strings, kWp, kW e CC/CA contra o resumo eletrico.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "ModeloFormato2" "Velho 2x2" "2" "2;2")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_TABELA_ANTES_DE_REGRAVAR")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "4")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "5")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "3")
(command "CLIVUS_ELETRICA_JANELA_MODELO_AUTO" "Huawei 250" "abc")
(command "CLIVUS_ELETRICA_JANELA_MODELO_AUTO" "Huawei 250" "-5")
(command "CLIVUS_ELETRICA_JANELA_MODELO_AUTO" "Huawei 250" "1.500")
(command "CLIVUS_ELETRICA_JANELA_MODELO_AUTO" "Huawei 250" "62,5")
(command "CLIVUS_ELETRICA_JANELA_MODELO_AUTO" "Huawei 250" "250")
(command "CLIVUS_ELETRICA_AUTO" "Skid" "T1" "Skid Norte" "Inversor 1;Inversor 2")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_TABELA_SKID_FEITO")
(command "CLIVUS_ELETRICA_JANELA_TRAFO_AUTO" "Inversor 1;Inversor 2;Inversor 3" "T2")
(command "CLIVUS_ELETRICA_JANELA_TRAFO_AUTO" "Inversor 3" "T1")
(command "CLIVUS_ELETRICA_JANELA_TRAFO_AUTO" "Inversor 4" "-")
(command "CLIVUS_ELETRICA_JANELA_TRAFO_AUTO" "Inversor 3" "T9")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_TABELA_LINHAS")
(command "CLIVUS_ELETRICA_JANELA_TABELA_AUTO")
(command "CLIVUS_ELETRICA_RESUMO_AUTO")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
