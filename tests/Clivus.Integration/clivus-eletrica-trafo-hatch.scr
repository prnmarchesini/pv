; Nivel 2 do hatch da area do trafo (pedido do Renan em 05/10/2026). O
; gancho CLIVUS_ELETRICA_JANELA_HATCH_AUTO chama o MESMO caminho do botao da
; aba Transformador, fora de comando. Sem inversor e sem string: recusado.
; T1 com o Inversor 1 (5 strings), T2 com o Inversor 2 (3 strings), T3 vazio.
; Gerar de novo substitui (nao duplica); "todos" faz T1 e T2 e recusa o T3.
; Cada hatch e lido da entidade: camada, padrao, cor (420), transparencia
; (440), cota (grupo 10), area e o trafo no XData. As faces dos modulos dao
; a faixa de cota (o hatch fica 0,30 m acima do canto mais alto da ilha).
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "2")
(princ "\nCLIVUS_PASSO sem_inversor")
(command "CLIVUS_ELETRICA_JANELA_HATCH_AUTO" "T1")
(command "CLIVUS_ELETRICA_AUTO" "Skid" "T1" "S1" "Inversor 1")
(princ "\nCLIVUS_PASSO sem_string")
(command "CLIVUS_ELETRICA_JANELA_HATCH_AUTO" "T1")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "5")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "3")
(command "CLIVUS_ELETRICA_AUTO" "Skid" "T2" "S2" "Inversor 2")
; A area pelos lacos de polilinha do proprio DXF do hatch (92, 72, 73, 93 e
; os 10): a de fora menos os buracos (getpropertyvalue nao existe no Core Console).
(defun clivus:anel (pts / a p q)
  (setq a 0.0 q (last pts))
  (foreach p pts (setq a (+ a (- (* (car q) (cadr p)) (* (car p) (cadr q)))) q p))
  (abs (/ a 2.0)))
(defun clivus:area (d / l g flags n pts total)
  (setq l (member (assoc 91 d) d) total 0.0)
  (while (setq l (member (assoc 92 l) l))
    (setq flags (cdr (car l)) l (cdr l))
    (if (= 2 (logand flags 2))
      (progn
        (setq l (member (assoc 93 l) l) n (cdr (car l)) l (cdr l) pts nil)
        (while (> n 0)
          (setq g (car l) l (cdr l))
          (if (= (car g) 10) (setq pts (cons (cdr g) pts) n (1- n))))
        (setq total (if (= 1 (logand flags 1)) (+ total (clivus:anel pts)) (- total (clivus:anel pts)))))))
  total)
(defun clivus:hatches ( / ss i e d xd r)
  (setq ss (ssget "_X" (list (cons 0 "HATCH") (list -3 (list "CLIVUS")))) i 0 r 0)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) i (1+ i) d (entget e (list "CLIVUS")) xd (cdr (cadr (assoc -3 d))))
    (if (= (cdr (nth 0 xd)) "AreaDoTrafo")
      (progn
        (setq r (1+ r))
        (princ (strcat "\nCLIVUS_HATCH h=" (cdr (assoc 5 d)) " camada=" (cdr (assoc 8 d)) " padrao=" (cdr (assoc 2 d))
                       " trafo=" (cdr (nth 2 xd)) " c420=" (itoa (cdr (assoc 420 d)))
                       " t440=" (if (assoc 440 d) (itoa (cdr (assoc 440 d))) "-1")
                       " z=" (rtos (cadddr (assoc 10 d)) 2 3) " area=" (rtos (clivus:area d) 2 2) " fim")))))
  (princ (strcat "\nCLIVUS_HATCHES n=" (itoa r))))
(princ "\nCLIVUS_PASSO t1")
(command "CLIVUS_ELETRICA_JANELA_HATCH_AUTO" "T1")
(clivus:hatches)
(princ "\nCLIVUS_PASSO t1_de_novo")
(command "CLIVUS_ELETRICA_JANELA_HATCH_AUTO" "T1")
(clivus:hatches)
(princ "\nCLIVUS_PASSO todos")
(command "CLIVUS_ELETRICA_JANELA_HATCH_AUTO" "*")
(clivus:hatches)
(princ "\nCLIVUS_PASSO fim")
(defun clivus:faces ( / ss i d zmin zmax k)
  (setq ss (ssget "_X" (list (cons 0 "3DFACE") (list -3 (list "CLIVUS")))) i 0 zmin 1e99 zmax -1e99)
  (while (and ss (< i (sslength ss)))
    (setq d (entget (ssname ss i)) i (1+ i))
    (foreach k '(10 11 12 13) (setq zmin (min zmin (cadddr (assoc k d))) zmax (max zmax (cadddr (assoc k d))))))
  (princ (strcat "\nCLIVUS_FACES n=" (itoa (if ss (sslength ss) 0)) " zmin=" (rtos zmin 2 3) " zmax=" (rtos zmax 2 3) " fim")))
(clivus:faces)
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
