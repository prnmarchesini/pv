; Nivel 2 do 11.7 (eletrica): o tracado desenhado acompanha o plano de cada
; modulo (regra eletrica 5 e regra sagrada 5). Usina mista no terreno de
; teste; Modelo 1 (uma de 28, convencional por fileira), Modelo 2 (uma de 14,
; leapfrog por fileira) e Modelo 3 (duas de 28 vizinhas, uma string por
; fileira que atravessa o vao entre as mesas); gerar em tudo. O LISP grava num arquivo os vertices
; de cada string LIDOS DA ENTIDADE, os cantos de cada face de modulo e a
; insercao (no mundo) de cada sinal + e -; quem confere a cota e o runner.
; Depois prende uma string da F1.1 a um inversor de mentira e gera de novo:
; nao duplica, e a presa continua la.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area mista eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:mesa (rotulo / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (cdr (nth 0 xd)) "Mesa") (= (cdr (nth 3 xd)) rotulo)) (setq achada e))
    (setq i (1+ i)))
  achada)
(defun clivus:junta (lista / ss) (setq ss (ssadd)) (foreach e lista (if e (ssadd e ss))) ss)
(defun clivus:perfil (rotulo) (cdr (nth 17 (clivus:xdata (clivus:mesa rotulo)))))
(defun clivus:primeira (perfil / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (cdr (nth 0 xd)) "Mesa") (= (cdr (nth 17 xd)) perfil)) (setq achada e))
    (setq i (1+ i)))
  achada)
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) clivus:i 0)
(while (< clivus:i (sslength clivus:ss))
  (setq clivus:xd (clivus:xdata (ssname clivus:ss clivus:i)))
  (if (= (cdr (nth 0 clivus:xd)) "Mesa") (princ (strcat "\nCLIVUS_MESA " (cdr (nth 3 clivus:xd)) " " (cdr (nth 17 clivus:xd)))))
  (setq clivus:i (1+ clivus:i)))
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:primeira "Mesa 2V28"))) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 1" "FILEIRA:C:0.0.0;FILEIRA:C:0.0.1")
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:primeira "Mesa 2V14"))) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 2" "FILEIRA:L:0.0.0;FILEIRA:L:0.0.1")
(defun clivus:par28 (/ f n a b par)
  (setq f 1)
  (while (and (< f 60) (not par))
    (setq n 1)
    (while (and (< n 30) (not par))
      (setq a (strcat "F" (itoa f) "." (itoa n)) b (strcat "F" (itoa f) "." (itoa (1+ n))))
      (if (and (clivus:mesa a) (clivus:mesa b) (= (clivus:perfil a) "Mesa 2V28") (= (clivus:perfil b) "Mesa 2V28"))
        (setq par (list (clivus:mesa a) (clivus:mesa b))))
      (setq n (1+ n)))
    (setq f (1+ f)))
  par)
(command "CLIVUS_STRING_MESAS" (clivus:junta (clivus:par28)) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 3" "FILEIRA:C:0.0.0;FILEIRA:C:0.0.1")
(command "CLIVUS_STRING_GERAR" (ssget "_X") "")
(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:num (x) (rtos x 2 4))
(defun clivus:pt (p) (strcat (clivus:num (car p)) " " (clivus:num (cadr p)) " " (clivus:num (caddr p))))
(setq clivus:arq (open "{{DUMP}}" "w"))
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS")))) clivus:i 0)
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:e (ssname clivus:ss clivus:i) clivus:xd (clivus:xdata clivus:e))
  (write-line (strcat "S " (cdr (nth 2 clivus:xd)) " " (cdr (nth 6 clivus:xd)) " " (cdr (nth 3 clivus:xd))) clivus:arq)
  (setq clivus:v (entnext clivus:e))
  (while (and clivus:v (= (cdr (assoc 0 (entget clivus:v))) "VERTEX"))
    (write-line (strcat "V " (clivus:pt (cdr (assoc 10 (entget clivus:v))))) clivus:arq)
    (setq clivus:v (entnext clivus:v)))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:ss (ssget "_X" (list (cons 0 "3DFACE") (cons 8 "CLIVUS_FACE"))) clivus:i 0)
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:d (entget (ssname clivus:ss clivus:i)))
  (write-line (strcat "F " (clivus:pt (cdr (assoc 10 clivus:d))) " " (clivus:pt (cdr (assoc 11 clivus:d))) " " (clivus:pt (cdr (assoc 12 clivus:d))) " " (clivus:pt (cdr (assoc 13 clivus:d)))) clivus:arq)
  (setq clivus:i (1+ clivus:i)))
(setq clivus:ss (ssget "_X" (list (cons 0 "TEXT") (cons 8 "CLIVUS_STRING"))) clivus:i 0)
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:e (ssname clivus:ss clivus:i) clivus:d (entget clivus:e))
  (write-line (strcat "T " (cdr (assoc 1 clivus:d)) " " (clivus:pt (trans (cdr (assoc 10 clivus:d)) clivus:e 0))) clivus:arq)
  (setq clivus:i (1+ clivus:i)))
(close clivus:arq)
(setq clivus:n1 (clivus:conta (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS"))))))
(setq clivus:t1 (clivus:conta (ssget "_X" (list (cons 0 "TEXT") (cons 8 "CLIVUS_STRING")))))
(command "CLIVUS_STRING_PRENDER_TESTE_AUTO" "F1.1")
(command "CLIVUS_STRING_GERAR" (ssget "_X") "")
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS")))) clivus:i 0 clivus:presas "")
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:xd (clivus:xdata (ssname clivus:ss clivus:i)))
  (if (/= (cdr (nth 4 clivus:xd)) "") (setq clivus:presas (strcat clivus:presas " " (cdr (nth 2 clivus:xd)))))
  (setq clivus:i (1+ clivus:i)))
(princ (strcat "\nCLIVUS_REGERAR antes=" (itoa clivus:n1) " textos=" (itoa clivus:t1)
               " depois=" (itoa (clivus:conta clivus:ss)) " textos=" (itoa (clivus:conta (ssget "_X" (list (cons 0 "TEXT") (cons 8 "CLIVUS_STRING")))))
               " presas=" clivus:presas))
(princ "\nCLIVUS_STRING_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
