; Nivel 2 do 11.3 (eletrica): polaridade e tracado convencional. Usina pelo
; motor, um tipo com a F1.1 (2V) e duas strings convencionais, uma por
; fileira (+ e - em pontas opostas); um clique em diagonal no leapfrog (no
; convencional ele vira um L desde 05/10/2026) e recusado e nao
; estraga o que ficou gravado.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:mesa (rotulo / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (cdr (nth 0 xd)) "Mesa") (= (cdr (nth 3 xd)) rotulo)) (setq achada e))
    (setq i (1+ i)))
  achada)
(defun clivus:junta (lista / ss) (setq ss (ssadd)) (foreach e lista (if e (ssadd e ss))) ss)
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:mesa "F1.1"))) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 1" "0.0.0 0.F.0;0.F.1 0.0.1")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 1" "0.0.0 L0.5.1")
(command "CLIVUS_STRING_TIPO_AUTO" "Listar")
(princ "\nCLIVUS_STRING_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
