; Teste de nivel 2 do 7.6: processa uma fileira, apaga o contorno de uma
; mesa com o ERASE (o vigia registra a remocao) e manda recontar. Confere:
;   - e apaga OUTRA mesa inteira (todas as pecas): o RECONTAR conta duas
;     mesas a menos, uma orfa, 28 modulos e 7 pilares a menos;
;   - lista a removida e limpa o registro: o CLIVUS_ESTADO depois diz 0.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
; A mesa e um grupo (27/09/2026): este caso simula o usuario mexendo em UMA
; peca, entao desliga a selecao por grupo (Ctrl+Shift+A na tela). O
; rodar.ps1 devolve o PICKSTYLE do registro no fim, como o SECURELOAD.
(setq clivus:pickstyle (getvar "PICKSTYLE"))
(setvar "PICKSTYLE" 0)
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area do recontar")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento do recontar")
(command "CLIVUS_FILEIRA_AUTO")
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))
(defun clivus:conta-tipo (tp / ss n i c)
  (setq ss (ssget "_X" (list (cons -3 (list (list "CLIVUS"))))) n (if ss (sslength ss) 0) i 0 c 0)
  (while (< i n) (if (= (clivus:tipo (clivus:xdata (ssname ss i))) tp) (setq c (1+ c))) (setq i (1+ i)))
  c)
(setq clivus:tudo (ssget "_X" (list (cons -3 (list (list "CLIVUS"))))))
(setq clivus:n (if clivus:tudo (sslength clivus:tudo) 0))
(setq clivus:eb nil clivus:i 0)
(while (and (< clivus:i clivus:n) (not clivus:eb))
  (setq clivus:en (ssname clivus:tudo clivus:i))
  (if (= (clivus:tipo (clivus:xdata clivus:en)) "Mesa") (setq clivus:eb clivus:en))
  (setq clivus:i (1+ clivus:i)))
(defun clivus:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun clivus:mesa (xd) (cond ((= (clivus:tipo xd) "Mesa") (clivus:campo xd 0)) ((= (clivus:tipo xd) "Face") (clivus:campo xd 2)) (T (clivus:campo xd 1))))
(setq clivus:antes (clivus:conta-tipo "Mesa") clivus:modantes (clivus:conta-tipo "Modulo") clivus:pilantes (clivus:conta-tipo "Pilar"))
; A mesa C: o segundo contorno, e todas as pecas dela.
(setq clivus:gc nil clivus:i 0 clivus:vistos 0)
(while (and (< clivus:i clivus:n) (not clivus:gc))
  (setq clivus:xd (clivus:xdata (ssname clivus:tudo clivus:i)))
  (if (= (clivus:tipo clivus:xd) "Mesa") (progn (setq clivus:vistos (1+ clivus:vistos)) (if (= clivus:vistos 2) (setq clivus:gc (clivus:campo clivus:xd 0)))))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:ssc (ssadd) clivus:i 0)
(while (< clivus:i clivus:n)
  (setq clivus:en (ssname clivus:tudo clivus:i))
  (if (= (clivus:mesa (clivus:xdata clivus:en)) clivus:gc) (ssadd clivus:en clivus:ssc))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:ssb (ssadd clivus:eb))
(command "_.ERASE" clivus:ssb "")
(command "_.ERASE" clivus:ssc "")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_RECONTAR")
(command "CLIVUS_ESTADO")
(princ (strcat "\nCLIVUS_RECONTAR_LISP antes=" (itoa clivus:antes) " modantes=" (itoa clivus:modantes) " pilantes=" (itoa clivus:pilantes)
               " mesas=" (itoa (clivus:conta-tipo "Mesa")) " modulos=" (itoa (clivus:conta-tipo "Modulo")) " pilares=" (itoa (clivus:conta-tipo "Pilar"))))
(setvar "PICKSTYLE" clivus:pickstyle)
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
