; Nivel 2 do 14.7 (eletrica): skid. Seis inversores e dois trafos em campo;
; a selecao do skid do T1 leva os retangulos dos inversores 1 a 4 e o do T2
; (que nao entra: so inversor); a do T2 leva os inversores 4 a 6 (o 4 esta
; travado no T1). Mover o Inversor 1 nao muda o skid dele.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "6")
(command "CLIVUS_ELETRICA_POSICIONAR" "T1" "{{P1}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "T2" "{{P2}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 1" "{{Q1}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 2" "{{Q2}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 3" "{{Q3}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 4" "{{Q4}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 5" "{{Q5}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 6" "{{Q6}}")
(defun clivus:tag (bloco / e d txt)
  (setq e (tblobjname "BLOCK" bloco) txt "?")
  (while (setq e (entnext e))
    (setq d (entget e))
    (if (= (cdr (assoc 0 d)) "MTEXT") (setq txt (cdr (assoc 1 d)))))
  txt)
(defun clivus:blocos (tags / ss i e r)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_EQUIPAMENTO_*"))) i 0 r (ssadd))
  (while (< i (sslength ss))
    (setq e (ssname ss i) i (1+ i))
    (if (member (clivus:tag (cdr (assoc 2 (entget e)))) tags) (ssadd e r)))
  r)
(setq clivus:sel1 (clivus:blocos (list "Inversor 1" "Inversor 2" "Inversor 3" "Inversor 4" "T2")))
(setq clivus:sel2 (clivus:blocos (list "Inversor 4" "Inversor 5" "Inversor 6")))
(princ (strcat "\nCLIVUS_SKID_SEL a=" (itoa (sslength clivus:sel1)) " b=" (itoa (sslength clivus:sel2))))
(command "CLIVUS_ELETRICA_SKID" "T1" "Skid Norte" clivus:sel1 "")
(command "CLIVUS_ELETRICA_SKID" "T2" "" clivus:sel2 "")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 1" "{{Q6}}")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
