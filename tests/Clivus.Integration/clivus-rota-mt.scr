; Nivel 2 da rota MT (10/10/2026): a vala e desenhada como no CAD do Renan,
; em 2D e com Z absurdo (9999, "o rabisco pode estar a centenas de metros do
; terreno"): uma principal com um vertice ao lado do trafo e um rabicho (LINE)
; que sai dela e entra no retangulo do trafo. Selecionar vala e Gerar MT; o
; comando de conferencia le cada vala e cada cabo do desenho e mede a cota de
; cada vertice contra o TIN no mesmo XY.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_ELETRICA_AUTO" "Uc" "Unitarias" "1")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "U1" "T1")
(command "CLIVUS_ELETRICA_POSICIONAR" "T1" "{{T}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "U1" "{{U}}")
(command "_.PLINE" "{{V1}}" "{{V2}}" "{{V3}}" "{{V4}}" "")
(setq clivus:principal (entlast))
(command "_.LINE" "{{R1}}" "{{R2}}" "")
(setq clivus:rabicho (entlast))
(setvar "OSMODE" clivus:osmode)
(setq clivus:sel (ssadd))
(ssadd clivus:principal clivus:sel)
(ssadd clivus:rabicho clivus:sel)
(princ "\nCLIVUS_ROTA VALA")
(command "CLIVUS_ROTA_VALA" "MT" clivus:sel "")
(princ "\nCLIVUS_ROTA GERAR")
(command "CLIVUS_ROTA_GERAR" "MT")
(princ "\nCLIVUS_ROTA CONFERIR")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
(princ "\nCLIVUS_ROTA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ)
