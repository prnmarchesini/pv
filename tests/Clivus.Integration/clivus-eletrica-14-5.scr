; Nivel 2 do 14.5 (eletrica): selecionar todas, soltar todas (as strings
; ficam no desenho, livres, com a mesma geometria), depois outro inversor
; pega as soltas; string de outro inversor fica travada; editar inversor.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "2")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "4")
(defun clivus:inv (e) (cdr (nth 4 (cdr (cadr (assoc -3 (entget e (list "CLIVUS"))))))))
(defun clivus:geo (e / v d n s)
  (setq v (entnext e) n 0 s 0.0)
  (while (and v (= (cdr (assoc 0 (setq d (entget v)))) "VERTEX"))
    (setq n (1+ n) s (+ s (car (cdr (assoc 10 d))) (cadr (cdr (assoc 10 d))) (caddr (cdr (assoc 10 d)))) v (entnext v)))
  (strcat (itoa n) ":" (rtos s 2 4)))
(defun clivus:strings () (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS")))))
(setq clivus:todas (clivus:strings) clivus:dele (ssadd) clivus:i 0)
(while (< clivus:i (sslength clivus:todas))
  (setq clivus:e (ssname clivus:todas clivus:i) clivus:i (1+ clivus:i))
  (if (/= (clivus:inv clivus:e) "") (ssadd clivus:e clivus:dele)))
(defun clivus:geos (ss / i r) (setq i 0 r "") (while (< i (sslength ss)) (setq r (strcat r " " (clivus:geo (ssname ss i))) i (1+ i))) r)
(setq clivus:antes (clivus:geos clivus:dele) clivus:total (sslength clivus:todas))
(command "CLIVUS_ELETRICA_SELECIONAR" "Inversor 1")
(setq clivus:impl (ssget "_I"))
(princ (strcat "\nCLIVUS_IMPLICITA n=" (itoa (if clivus:impl (sslength clivus:impl) 0))))
(sssetfirst nil nil)
(command "CLIVUS_ELETRICA_AUTO" "SoltarInversor" "Inversor 1")
(setq clivus:depois (clivus:geos clivus:dele))
(princ (strcat "\nCLIVUS_SOLTAS dele=" (itoa (sslength clivus:dele)) " total_antes=" (itoa clivus:total) " total_depois=" (itoa (sslength (clivus:strings)))
               " livres=" (itoa (length (vl-remove-if-not '(lambda (x) (= (clivus:inv x) "")) (mapcar 'cadr (ssnamex clivus:dele))))) " fim"))
(princ (strcat "\nCLIVUS_GEO_ANTES" clivus:antes " fim"))
(princ (strcat "\nCLIVUS_GEO_DEPOIS" clivus:depois " fim"))
(command "CLIVUS_ELETRICA_ALOCAR" "Inversor 2" clivus:dele "")
(command "CLIVUS_ELETRICA_ALOCAR" "Inversor 1" clivus:dele "")
(command "CLIVUS_ELETRICA_AUTO" "EditarInversor" "Inversor 2" "INV-NORTE" "Huawei 250")
;; Um COPY de string livre (o XData vai junto): alocar com as duas e recusado.
(setq clivus:livre (car (vl-remove-if '(lambda (e) (/= (clivus:inv e) "")) (mapcar 'cadr (ssnamex (clivus:strings))))))
(command "_.COPY" clivus:livre "" "0,0" "0,0.5")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "1000")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
