; Nivel 2 da reprovacao de 05/10/2026 ("era para ter uma listinha para eu
; colocar as UCs"): o desenho antigo (UCs compartilhadas sem bloco, formato 1)
; e lido com as UCs num bloco; o bloco ganha nome, tamanho e mais UCs; cada UC
; tem nome e trafos proprios; o resumo mostra o bloco com as UCs dentro;
; apagar o bloco leva as UCs dele e solta os trafos.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_ELETRICA_AUTO" "UcAntiga")
(princ "\nCLIVUS_BLOCO_LIDO")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "UC1" "T1")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "UC1" "T2")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "U1" "T3")
(command "CLIVUS_ELETRICA_AUTO" "Uc" "Compartilhada")
(command "CLIVUS_ELETRICA_AUTO" "EditarUc" "UC2" "Medicao Sul")
(command "CLIVUS_ELETRICA_AUTO" "Bloco" "Cubiculo Norte" "6" "3" "2,8")
(princ "\nCLIVUS_BLOCO_GRAVADO")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(command "CLIVUS_ELETRICA_RESUMO_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "ApagarBloco")
(princ "\nCLIVUS_BLOCO_APAGADO")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
