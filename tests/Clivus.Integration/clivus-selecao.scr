; Teste de nivel 2 do 7.8: processa uma fileira, poe na selecao previa
; (sssetfirst) todas as entidades de duas mesas e um pilar so de uma
; terceira, e manda CLIVUS_KWP_SELECAO: tem que dizer 3 mesas, 84 modulos e
; 60,5 kWp (28 x 3 x 720 W: a mesa entra inteira mesmo que so um pilar dela
; esteja selecionado). Sem selecao nossa, diz que nao ha mesa.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area da selecao")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento da selecao")
(command "CLIVUS_FILEIRA_AUTO")
(setvar "OSMODE" clivus:osmode)
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))
(defun clivus:mesa (xd) (cond ((= (clivus:tipo xd) "Mesa") (clivus:campo xd 0)) ((= (clivus:tipo xd) "Face") (clivus:campo xd 2)) (T (clivus:campo xd 1))))
(setq clivus:tudo (ssget "_X" (list (cons -3 (list (list "CLIVUS"))))))
(setq clivus:n (if clivus:tudo (sslength clivus:tudo) 0))
(setq clivus:g1 nil clivus:g2 nil clivus:g3 nil clivus:vistos 0 clivus:i 0)
(while (< clivus:i clivus:n)
  (setq clivus:xd (clivus:xdata (ssname clivus:tudo clivus:i)))
  (if (= (clivus:tipo clivus:xd) "Mesa")
    (progn (setq clivus:vistos (1+ clivus:vistos))
           (if (= clivus:vistos 1) (setq clivus:g1 (clivus:campo clivus:xd 0)))
           (if (= clivus:vistos 2) (setq clivus:g2 (clivus:campo clivus:xd 0)))
           (if (= clivus:vistos 3) (setq clivus:g3 (clivus:campo clivus:xd 0)))))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:ss (ssadd) clivus:pilar3 nil clivus:i 0)
(while (< clivus:i clivus:n)
  (setq clivus:en (ssname clivus:tudo clivus:i) clivus:xd (clivus:xdata clivus:en) clivus:m (clivus:mesa clivus:xd))
  (if (or (= clivus:m clivus:g1) (= clivus:m clivus:g2)) (ssadd clivus:en clivus:ss))
  (if (and (not clivus:pilar3) (= clivus:m clivus:g3) (= (clivus:tipo clivus:xd) "Pilar")) (setq clivus:pilar3 clivus:en))
  (setq clivus:i (1+ clivus:i)))
(ssadd clivus:pilar3 clivus:ss)
(princ (strcat "\nCLIVUS_SELECAO_LISP selecionadas=" (itoa (sslength clivus:ss))))
(sssetfirst nil clivus:ss)
(command "CLIVUS_KWP_SELECAO")
; Sem selecao nossa: uma linha qualquer.
(command "_.LINE" "0,0,0" "10,0,0" "")
(setq clivus:linha (entlast))
(setq clivus:ssl (ssadd clivus:linha))
(sssetfirst nil clivus:ssl)
(command "CLIVUS_KWP_SELECAO")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
