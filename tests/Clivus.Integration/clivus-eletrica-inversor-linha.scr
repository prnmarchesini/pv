; Nivel 2 da edicao direto na linha da tabela de inversores (05/10/2026, o
; bloco "Escolhido" saiu): o nome editado na celula (vazio e repetido
; recusados), o modelo da caixa da linha (recusado se tem menos entradas que
; as strings ja alocadas) e o Apagar das linhas escolhidas, pelo mesmo caminho
; da janela (contexto da aplicacao, fora de comando).
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Pequeno" "2" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "4")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "5")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "3")
(command "CLIVUS_ELETRICA_AUTO" "Skid" "T1" "Skid Norte" "Inversor 1;Inversor 2")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_LINHA_ANTES")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 1" "Modelo" "Pequeno")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 2" "Modelo" "Pequeno")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 3" "Modelo" "Nenhum")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 1" "Nome" ".")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 1" "Nome" "inversor 2")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 1" "Nome" "  INV-NORTE ")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "INV-NORTE;Inversor 3" "Nome" "X")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_LINHA_EDITADA")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "INV-NORTE;Inversor 2" "Apagar" ".")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
