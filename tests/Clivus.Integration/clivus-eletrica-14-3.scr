; Nivel 2 do 14.3 (eletrica): alocacao de strings pela selecao. Usina pelo
; motor e strings de teste; o Inversor 1 fica com 3 strings (AUTO); a
; selecao do Inversor 2 leva as 3 dele (travadas), 5 livres, modulos e o
; alinhamento: so as 5 livres entram. A geometria das strings nao muda.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "2")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "3")
(defun clivus:inv (e) (cdr (nth 4 (cdr (cadr (assoc -3 (entget e (list "CLIVUS"))))))))
(defun clivus:geo (e / v d n s)
  (setq v (entnext e) n 0 s 0.0)
  (while (and v (= (cdr (assoc 0 (setq d (entget v)))) "VERTEX"))
    (setq n (1+ n) s (+ s (car (cdr (assoc 10 d))) (cadr (cdr (assoc 10 d))) (caddr (cdr (assoc 10 d)))) v (entnext v)))
  (strcat (itoa n) ":" (rtos s 2 4)))
(setq clivus:todas (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS"))))
      clivus:sel (ssadd) clivus:i 0 clivus:alocadas 0 clivus:livres 0 clivus:antes "")
(while (< clivus:i (sslength clivus:todas))
  (setq clivus:e (ssname clivus:todas clivus:i) clivus:i (1+ clivus:i))
  (cond ((and (/= (clivus:inv clivus:e) "") (< clivus:alocadas 3)) (setq clivus:alocadas (1+ clivus:alocadas)) (ssadd clivus:e clivus:sel))
        ((and (= (clivus:inv clivus:e) "") (< clivus:livres 5)) (setq clivus:livres (1+ clivus:livres)) (ssadd clivus:e clivus:sel))))
(setq clivus:i 0)
(while (< clivus:i (sslength clivus:sel)) (setq clivus:antes (strcat clivus:antes " " (clivus:geo (ssname clivus:sel clivus:i))) clivus:i (1+ clivus:i)))
(setq clivus:modulos (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_MODULO_*"))) clivus:i 0)
(while (< clivus:i 20) (ssadd (ssname clivus:modulos clivus:i) clivus:sel) (setq clivus:i (1+ clivus:i)))
(ssadd (ssname (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_ALINHAMENTO"))) 0) clivus:sel)
(princ (strcat "\nCLIVUS_SEL alocadas=" (itoa clivus:alocadas) " livres=" (itoa clivus:livres) " total=" (itoa (sslength clivus:sel))))
(command "CLIVUS_ELETRICA_ALOCAR" "Inversor 2" clivus:sel "")
(setq clivus:depois "" clivus:i 0)
(while (< clivus:i (+ clivus:alocadas clivus:livres)) (setq clivus:depois (strcat clivus:depois " " (clivus:geo (ssname clivus:sel clivus:i))) clivus:i (1+ clivus:i)))
(princ (strcat "\nCLIVUS_GEO_ANTES" clivus:antes " fim"))
(princ (strcat "\nCLIVUS_GEO_DEPOIS" clivus:depois " fim"))
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
