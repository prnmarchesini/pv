; Nivel 2 do 12.3 (eletrica): o retangulo da subestacao em campo. Os pontos
; vem com Z absurdo (9999): a cota tem que vir do terreno. A UC1 e posta duas
; vezes (a segunda move o mesmo retangulo); o vinculo com o T1 nao muda.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Uc" "Compartilhada")
(command "CLIVUS_ELETRICA_AUTO" "Uc" "Unitarias" "1")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "UC1" "T1")
(command "CLIVUS_ELETRICA_POSICIONAR" "UC1" "{{P1}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "u1" "{{P2}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "UC1" "{{P3}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "UC9")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(defun clivus:equip ( / ss i e d x p)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (list -3 (list "CLIVUS")))) i 0)
  (princ (strcat "\nCLIVUS_EQUIP_TOTAL n=" (itoa (if ss (sslength ss) 0))))
  (if ss
    (while (< i (sslength ss))
      (setq e (ssname ss i) d (entget e (list "CLIVUS")) x (cdr (cadr (assoc -3 d))) p (cdr (assoc 10 d)) i (1+ i))
      (if (= (cdr (car x)) "Equipamento")
        (princ (strcat "\nCLIVUS_EQUIP tipo=" (cdr (nth 2 x)) " x=" (rtos (car p) 2 3) " y=" (rtos (cadr p) 2 3) " z=" (rtos (caddr p) 2 3)
                       " layer=" (cdr (assoc 8 d)) " bloco=" (cdr (assoc 2 d)) " fim")))))
  (princ))
(clivus:equip)
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
