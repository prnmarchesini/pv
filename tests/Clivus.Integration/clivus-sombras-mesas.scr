; Teste de nivel 2 da sombra das MESAS (05/10/2026, Renan: "o motor de
; sombras tem que gerar as sombras de todos objetos do desenho"; 42.1: "as
; mesas geram sombras e eu nao estou vendo") e do Cancelar do andamento.
; Usina SEM arvore: as 07:30 de 21/06/2026 (sol baixo) as mesas fazem sombra
; no chao e na fileira de tras; a sombra e desenhada em hachura magenta, no
; chao cada pedaco num plano 4 cm acima do terreno (regra 5) e sobre as
; mesas no plano delas, 3 cm acima dos modulos. As cotas sao lidas da
; entidade (o contorno da hachura no OCS dela, levado ao mundo pela normal).
; Depois o ano inteiro, cancelado no 5o passo do andamento (pelo caminho do
; botao, sem janela): nada muda no desenho. Por fim o dia inteiro.

(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area sombras")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento sombras")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)

(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))

; As entidades de sombra (XData "Sombra") de um tipo e de um lugar ("Chao", "Mesa" ou nil).
(defun clivus:sombras (tipo onde / ss i e xd l)
  (setq ss (ssget "_X" (list (cons 0 tipo) (list -3 (list "CLIVUS")))) i 0 l nil)
  (while (< i (clivus:conta ss))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (cdr (nth 0 xd)) "Sombra") (or (null onde) (= (cdr (nth 3 xd)) onde))) (setq l (cons e l)))
    (setq i (1+ i)))
  l)

; Os vertices do contorno da hachura no mundo (os 10 entre o 91 e o 75).
(defun clivus:hverts (e / d elev normal dentro l)
  (setq d (entget e) elev (cadddr (assoc 10 d)) normal (cdr (assoc 210 d)) dentro nil l nil)
  (foreach g d
    (cond ((= (car g) 91) (setq dentro T))
          ((= (car g) 75) (setq dentro nil))
          ((and dentro (= (car g) 10)) (setq l (cons (trans (list (cadr g) (caddr g) elev) normal 0) l)))))
  l)

; As hachuras de sombra de um lugar: quantas e a faixa de cotas dos vertices.
(defun clivus:hachuras (onde / n zmin zmax)
  (setq n 0 zmin 1e99 zmax -1e99)
  (foreach e (clivus:sombras "HATCH" onde)
    (setq n (1+ n))
    (foreach p (clivus:hverts e) (setq zmin (min zmin (caddr p)) zmax (max zmax (caddr p)))))
  (list n zmin zmax))

(defun clivus:assinatura ( / ss i l)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_MOD*"))) i 0)
  (while (< i (clivus:conta ss))
    (setq l (cons (list (cdr (assoc 5 (entget (ssname ss i)))) (cdr (assoc 62 (entget (ssname ss i)))) (cdr (assoc 420 (entget (ssname ss i))))) l) i (1+ i)))
  l)
(defun clivus:quantas () (list (length (clivus:sombras "HATCH" nil)) (length (clivus:sombras "POLYLINE" nil)) (length (clivus:sombras "MTEXT" nil))))

(setq clivus:modulos (clivus:assinatura))
(command "CLIVUS_SOMBRAS_AUTO" "21/06/2026" "21/06/2026" "07:30" "07:30" "30" "-3" "1")
(setq clivus:chao (clivus:hachuras "Chao") clivus:mesa (clivus:hachuras "Mesa"))

; O Cancelar: nada muda (as entidades de sombra e as cores iguais as de antes).
(setq clivus:antes (list (clivus:assinatura) (clivus:quantas) clivus:chao clivus:mesa))
(princ "\nCLIVUS_CANCELAR_ANTES")
(clivus-sombras-cancelar "01/01/2026" "31/12/2026" "-3" 5)
(setq clivus:iguais (equal clivus:antes (list (clivus:assinatura) (clivus:quantas) (clivus:hachuras "Chao") (clivus:hachuras "Mesa"))))

(command "CLIVUS_SOMBRAS_AUTO" "21/06/2026" "21/06/2026" "06:00" "18:00" "60" "-3" "1")
(setq clivus:dia (clivus:hachuras "Chao"))

(princ (strcat "\nCLIVUS_SOMBRAS_MESAS chao=" (itoa (car clivus:chao))
               " zmin=" (rtos (cadr clivus:chao) 2 3) " zmax=" (rtos (caddr clivus:chao) 2 3)
               " mesa=" (itoa (car clivus:mesa))
               " mzmin=" (rtos (cadr clivus:mesa) 2 3) " mzmax=" (rtos (caddr clivus:mesa) 2 3)
               " iguais=" (if clivus:iguais "1" "0") " dia=" (itoa (car clivus:dia))
               " repintou=" (if (equal clivus:modulos (clivus:assinatura)) "0" "1") " fim"))
(setvar "SECURELOAD" clivus:secureload)
(princ)
