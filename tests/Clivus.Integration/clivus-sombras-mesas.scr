; Teste de nivel 2 da sombra das MESAS (05/10/2026, Renan: "ao gerar sombras,
; quero que gere as sombras das mesas tambem, o motor de sombras tem que gerar
; as sombras de todos objetos do desenho") e do Cancelar do andamento ("um
; botao de cancelar a qualquer momento"). Usina SEM arvore: as 07:30 de
; 21/06/2026 (sol baixo) as mesas fazem sombra no chao e na fileira de tras;
; a sombra e desenhada (so borda), no chao na cota do terreno (regra 5) e
; sobre as mesas no plano delas. Depois o ano inteiro, cancelado no 5o passo
; do andamento (pelo caminho do botao, sem janela): nada muda no desenho.
; Por fim o dia inteiro: a mancha do dia.

(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area sombras")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento sombras")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)

(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:verts (e / v l)
  (setq v (entnext e))
  (while (and v (= (cdr (assoc 0 (entget v))) "VERTEX"))
    (setq l (cons (cdr (assoc 10 (entget v))) l) v (entnext v)))
  l)

; Os contornos de sombra de um tipo ("Chao" ou "Mesa"): quantos e a faixa de
; cotas dos vertices, lida da entidade.
(defun clivus:sombras (onde / ss i n zmin zmax xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0 n 0 zmin 1e99 zmax -1e99)
  (while (< i (clivus:conta ss))
    (setq xd (clivus:xdata (ssname ss i)))
    (if (and (= (cdr (nth 0 xd)) "Sombra") (= (cdr (nth 3 xd)) onde))
      (progn
        (setq n (1+ n))
        (foreach p (clivus:verts (ssname ss i)) (setq zmin (min zmin (caddr p)) zmax (max zmax (caddr p))))))
    (setq i (1+ i)))
  (list n zmin zmax))
(defun clivus:assinatura ( / ss i l)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_MOD*"))) i 0)
  (while (< i (clivus:conta ss))
    (setq l (cons (list (cdr (assoc 5 (entget (ssname ss i)))) (cdr (assoc 62 (entget (ssname ss i)))) (cdr (assoc 420 (entget (ssname ss i))))) l) i (1+ i)))
  l)

(command "CLIVUS_SOMBRAS_AUTO" "21/06/2026" "21/06/2026" "07:30" "07:30" "30" "-3" "1")
(setq clivus:chao (clivus:sombras "Chao") clivus:mesa (clivus:sombras "Mesa"))

; O Cancelar: nada muda (contornos e cores iguais aos de antes).
(setq clivus:antes (list (clivus:assinatura) clivus:chao clivus:mesa))
(princ "\nCLIVUS_CANCELAR_ANTES")
(clivus-sombras-cancelar "01/01/2026" "31/12/2026" "-3" 5)
(setq clivus:iguais (equal clivus:antes (list (clivus:assinatura) (clivus:sombras "Chao") (clivus:sombras "Mesa"))))

(command "CLIVUS_SOMBRAS_AUTO" "21/06/2026" "21/06/2026" "06:00" "18:00" "60" "-3" "1")
(setq clivus:dia (clivus:sombras "Chao"))

(princ (strcat "\nCLIVUS_SOMBRAS_MESAS chao=" (itoa (car clivus:chao))
               " zmin=" (rtos (cadr clivus:chao) 2 3) " zmax=" (rtos (caddr clivus:chao) 2 3)
               " mesa=" (itoa (car clivus:mesa))
               " mzmin=" (rtos (cadr clivus:mesa) 2 3) " mzmax=" (rtos (caddr clivus:mesa) 2 3)
               " iguais=" (if clivus:iguais "1" "0") " dia=" (itoa (car clivus:dia))))
(setvar "SECURELOAD" clivus:secureload)
(princ)
