; Nivel 2 do local dos inversores (10/10/2026). Usina pelo motor, strings de
; teste, um modelo e quatro inversores. (1) Area: um retangulo 2D desenhado
; ao leste da usina (60 x 60 m) vira a area do Inversor 2, 3 e 4: eles vao para dentro
; dele, na cota do terreno + 0,80, e o retangulo vira Polyline3d no TIN. (2)
; Automatico: o Inversor 1 recebe 6 strings e fica automatico; uma vala CC
; norte-sul a 5 m da borda leste; o Gerar CC poe o Inversor 1 ao lado da vala
; (ele nao estava em campo) e traca os 12 lances. (3) Movido a mao e Gerado
; de novo, fica onde foi posto. (4) Recolocar: volta para o lado da vala.
; Melhorias de 10/10/2026: (5) renomear a area; (6) 9 inversores numa area em
; pe que comeca pelo lado curto (o erro da image2) e o 10o sozinho na vaga
; livre; (7) area pequena; (8) automatico apaga o retangulo e trava o Por em
; campo; (9) Ver em campo; (10) Repartir pela fila e a soma dos limites; (11)
; pre-tag no Distribuir, apagada no Soltar e na Numeracao; de volta ao apagar as tags.
; Segunda rodada de 10/10/2026: (12) a area do Itatiba com 8 e depois o 9 e o
; 10 pelo Escolher area; Por em campo e MOVE dentro e fora da area (o local pela
; geometria, "A mao" fora); renomear pela lista Areas...; o total do Limite;
; (13) a pre-tag com fundo e moldura, sem eles e nenhuma com Inserir nome desmarcado.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area local")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento local")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "4")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "6")
(defun clivus:etiqueta (bloco / e d txt)
  (setq e (tblobjname "BLOCK" bloco) txt "?")
  (while (setq e (entnext e))
    (setq d (entget e))
    (if (= (cdr (assoc 0 d)) "MTEXT") (setq txt (cdr (assoc 1 d)))))
  txt)
(defun clivus:equip (etapa / ss i e d p)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_EQUIPAMENTO_*"))) i 0)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) d (entget e) p (cdr (assoc 10 d)) i (1+ i))
    (princ (strcat "\nCLIVUS_LOCAL_EQUIP etapa=" etapa " tag=" (vl-string-translate " " "_" (clivus:etiqueta (cdr (assoc 2 d))))
                   " x=" (rtos (car p) 2 3) " y=" (rtos (cadr p) 2 3) " z=" (rtos (caddr p) 2 3) " fim")))
  (princ))
; ---- (1) area -------------------------------------------------------------
(command "_.PLINE" "{{S1}}" "{{S2}}" "{{S3}}" "{{S4}}" "_C")
(setq clivus:sala (entlast))
(princ "\nCLIVUS_LOCAL AREA")
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 2;Inversor 3;Inversor 4" clivus:sala "Sala 1")
(setq clivus:ss (ssget "_X" (list (list -3 (list "CLIVUS")))) clivus:i 0)
(while (and clivus:ss (< clivus:i (sslength clivus:ss)))
  (setq clivus:d (entget (ssname clivus:ss clivus:i) (list "CLIVUS")) clivus:i (1+ clivus:i))
  (if (= (cdr (cadr (cadr (assoc -3 clivus:d)))) "AreaInversores")
    (princ (strcat "\nCLIVUS_LOCAL_SALA tipo=" (cdr (assoc 0 clivus:d)) " flags=" (itoa (cdr (assoc 70 clivus:d))) " fim"))))
(clivus:equip "area")
(princ "\nCLIVUS_LOCAL CONFERIR_AREA")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
; ---- (2) automatico -------------------------------------------------------
(command "CLIVUS_ELETRICA_LOCAL" "Strings" "Inversor 1")
(command "_.PLINE" "{{V1}}" "{{V2}}" "")
(setq clivus:vala (ssadd (entlast)))
(command "CLIVUS_ROTA_VALA" "CC" clivus:vala "")
(princ "\nCLIVUS_LOCAL GERAR1")
(command "CLIVUS_ROTA_GERAR" "CC")
(clivus:equip "auto")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
; ---- (3) movido a mao -----------------------------------------------------
(princ "\nCLIVUS_LOCAL MOVER")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 1" "{{M}}")
(command "CLIVUS_ROTA_GERAR" "CC")
(clivus:equip "movido")
; ---- (4) recolocar --------------------------------------------------------
(princ "\nCLIVUS_LOCAL RECOLOCAR")
(command "CLIVUS_ROTA_RECOLOCAR" "CC")
(clivus:equip "recolocado")
; ---- (5) renomear a area -------------------------------------------------
(princ "\nCLIVUS_LOCAL RENOMEAR")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Renomear" "Sala 1" "Skid norte")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Renomear" "Skid norte" ".")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
(defun clivus:areapor (nome / ss i e d achado)
  (setq ss (ssget "_X" (list (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achado))
    (setq e (ssname ss i) d (entget e (list "CLIVUS")) i (1+ i))
    (if (and (member (cons 1000 "AreaInversores") (cadr (assoc -3 d))) (member (cons 1000 nome) (cadr (assoc -3 d)))) (setq achado e)))
  achado)
; ---- (6) 9 numa area em pe (comeca pelo lado curto) e o 10o sozinho -----
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "10")
(command "_.PLINE" "{{T1}}" "{{T2}}" "{{T3}}" "{{T4}}" "_C")
(setq clivus:alta (entlast))
(princ "\nCLIVUS_LOCAL AREA2")
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 5;Inversor 6;Inversor 7;Inversor 8;Inversor 9;Inversor 10;Inversor 11;Inversor 12;Inversor 13" clivus:alta "Sala 2")
(princ "\nCLIVUS_LOCAL ULTIMO")
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 14" (clivus:areapor "Sala 2"))
(princ "\nCLIVUS_LOCAL CONFERIR_AREA2")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
; ---- (7) area pequena: cabe 1 de 2 -----------------------------------------
(command "_.PLINE" "{{P1}}" "{{P2}}" "{{P3}}" "{{P4}}" "_C")
(princ "\nCLIVUS_LOCAL PEQUENA")
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 2;Inversor 3" (entlast) "")
(princ "\nCLIVUS_LOCAL PEQUENA_FIM")
; ---- (8) automatico apaga o retangulo e trava o Por em campo -------------
(princ "\nCLIVUS_LOCAL AUTOMATICO")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Automatico" "Inversor 4" ".")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 4")
(clivus:equip "automatico")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
(princ "\nCLIVUS_LOCAL AUTOMATICO_FIM")
; ---- (9) Ver em campo ------------------------------------------------------
(princ "\nCLIVUS_LOCAL VER")
(command "CLIVUS_ELETRICA_VER" "Inversor 5" "")
(setq clivus:sel (ssget "_I"))
(princ (strcat "\nCLIVUS_LOCAL_VER selecionados=" (itoa (if clivus:sel (sslength clivus:sel) 0)) " fim"))
(sssetfirst nil nil)
(command "CLIVUS_ELETRICA_VER" "Inversor 4")
(princ "\nCLIVUS_LOCAL VER_FIM")
; ---- (10) Repartir pela fila e a soma dos limites --------------------------
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Manual" "Inversor 4" ".")
(princ "\nCLIVUS_LOCAL REPARTIR")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Repartir" "*" ".")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
(princ "\nCLIVUS_LOCAL REPARTIR_FIM")
; ---- (11) pre-tag: Distribuir, Soltar e Numeracao ---------------------------
(defun clivus:pretags (etapa / ss i e d xd)
  (setq ss (ssget "_X" (list (cons 0 "MTEXT") (cons 8 "CLIVUS_STRING_PRETAG"))) i 0)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) d (entget e (list "CLIVUS")) xd (cadr (assoc -3 d)) i (1+ i))
    (princ (strcat "\nCLIVUS_PRETAG etapa=" etapa " texto=" (cdr (assoc 1 d)) " tipo=" (cdr (nth 1 xd))
                   " rot=" (rtos (cdr (assoc 50 d)) 2 4) " z=" (rtos (cadddr (assoc 10 d)) 2 3) " fim")))
  (setq ss (ssget "_X" (list (cons 0 "MTEXT") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)))
    (setq d (entget (ssname ss i) (list "CLIVUS")) i (1+ i))
    (if (member (cons 1000 "StringTag") (cadr (assoc -3 d))) (princ (strcat "\nCLIVUS_TAGREAL etapa=" etapa " fim"))))
  (princ (strcat "\nCLIVUS_PRETAG_FIM " etapa)))
(defun clivus:zstrings (/ ss i e z zmin zmax)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING"))) i 0 zmin 1e99 zmax -1e99)
  (while (and ss (< i (sslength ss)))
    (setq e (entnext (ssname ss i)) i (1+ i))
    (while (and e (= (cdr (assoc 0 (entget e))) "VERTEX"))
      (setq z (cadddr (assoc 10 (entget e))) zmin (min zmin z) zmax (max zmax z) e (entnext e))))
  (princ (strcat "\nCLIVUS_ZSTRINGS min=" (rtos zmin 2 3) " max=" (rtos zmax 2 3) " fim")))
(clivus:zstrings)
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "SoltarUsina" ".")
(command "CLIVUS_ELETRICA_AUTO" "Atribuir")
(clivus:pretags "distribuido")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 1" "Soltar" ".")
(clivus:pretags "solto")
(command "CLIVUS_NUMERACAO_AUTO" "Gerar")
(clivus:pretags "numerado")
; Apagar as tags pela aba Numeracao (o botao): a string que continua num inversor volta a ter a pre-tag.
(command "CLIVUS_NUMERACAO_TELA_AUTO" "Apagar" "Usina")
(clivus:pretags "tagsapagadas")
; ---- (12) segunda rodada de 10/10/2026, item 2 (reincidencia) --------------
; (a) a Area 1 do Itatiba do Renan (3,7717 x 5,1538 m): 8 pelo Escolher area,
; depois o 9 e o 10 pelo Escolher area na MESMA area (antes: "0 de 2", calado).
(defun clivus:inv (tag / ss i e achado)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_EQUIPAMENTO_*"))) i 0)
  (while (and ss (< i (sslength ss)) (not achado))
    (setq e (ssname ss i) i (1+ i))
    (if (= (clivus:etiqueta (cdr (assoc 2 (entget e)))) tag) (setq achado e)))
  achado)
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "12")
(command "_.PLINE" "{{I1}}" "{{I2}}" "{{I3}}" "{{I4}}" "_C")
(princ "\nCLIVUS_LOCAL G_OITO")
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 15;Inversor 16;Inversor 17;Inversor 18;Inversor 19;Inversor 20;Inversor 21;Inversor 22" (entlast) "Area Itatiba")
(princ "\nCLIVUS_LOCAL G_NOVE_DEZ")
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 23;Inversor 24" (clivus:areapor "Area Itatiba"))
(princ "\nCLIVUS_LOCAL G_CONFERIR")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
; (b) Por em campo a mao, num ponto dentro da Skid norte: a coluna Local mostra a area.
(princ "\nCLIVUS_LOCAL G_MAO")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 25" "{{J1}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 26" "{{J2}}")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
; (c) o MOVE do AutoCAD leva o Inversor 26 para dentro da Skid norte e depois para fora.
(princ "\nCLIVUS_LOCAL G_MOVE_DENTRO")
(command "_.MOVE" (clivus:inv "Inversor 26") "" "0,0" "{{DJ}}")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
(princ "\nCLIVUS_LOCAL G_MOVE_FORA")
(command "_.MOVE" (clivus:inv "Inversor 26") "" "{{DJ}}" "0,0")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
; (d) renomear pela lista do botao Areas...
(princ "\nCLIVUS_LOCAL G_AREAS")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Areas" "*" ".")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Renomear" "Area Itatiba" "Sala Itatiba")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Areas" "*" ".")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
; e pelo botao direito na polilinha da area (o comando do menu).
(command "CLIVUS_ELETRICA_AREA_RENOMEAR" (clivus:areapor "Sala Itatiba") "Sala Itatiba B")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Areas" "*" ".")
(princ "\nCLIVUS_LOCAL G_FIM")
; ---- (14) revisao de 10/10/2026, a noite ---------------------------------
; (a) MOVE de um inversor a mao para um ponto de outra cota: o vigia poe a base
; no TIN + 0,80 no fim do MOVE (sem abrir a aba).
(princ "\nCLIVUS_LOCAL R_MOVE")
(command "_.MOVE" (clivus:inv "Inversor 26") "" "0,0" "{{DR}}")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
; (b) um U desfaz o MOVE e o assentar juntos (o mesmo grupo de UNDO).
(princ "\nCLIVUS_LOCAL R_UNDO")
(clivus:equip "antesu")
(command "_.MOVE" (clivus:inv "Inversor 26") "" "0,0" "{{DR}}")
(clivus:equip "movidou")
(command "_.U")
(clivus:equip "desfeitou")
; (c) mudado sem comando (entmod, como um LISP): o vigia nao ve; a leitura da aba poe no TIN + 0,80.
(princ "\nCLIVUS_LOCAL R_ENTMOD")
(setq clivus:e26 (clivus:inv "Inversor 26") clivus:d26 (entget clivus:e26) clivus:p26 (cdr (assoc 10 clivus:d26)))
(entmod (subst (list 10 (car clivus:p26) (- (cadr clivus:p26) {{DE}}) (caddr clivus:p26)) (assoc 10 clivus:d26) clivus:d26))
(command "CLIVUS_ROTA_CONFERIR_AUTO")
(princ "\nCLIVUS_LOCAL R_ENTMOD_ABA")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
; (d) COPY da polilinha da Skid norte: a copia e outra area (GUID e nome proprios);
; o 26 levado para dentro da copia e dela, e a Skid norte continua com os dela.
(princ "\nCLIVUS_LOCAL R_COPIA")
(command "_.COPY" (clivus:areapor "Skid norte") "" "0,0" "{{DC}}")
(command "_.MOVE" (clivus:inv "Inversor 26") "" "{{DQ1}}" "{{DQ2}}")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Areas" "*" ".")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "Linhas" "*" ".")
; (e) MOVE da polilinha da area (Sala Itatiba B): o vigia a drapeia de novo no terreno do lugar novo.
(princ "\nCLIVUS_LOCAL R_AREA_MOVE")
(command "_.MOVE" (clivus:areapor "Sala Itatiba B") "" "0,0" "0,8")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
(princ "\nCLIVUS_LOCAL R_FIM")
; ---- (13) item 5: pre-tag com fundo e moldura; sem nada com Inserir nome desmarcado
(defun clivus:pretagf (etapa / ss i d f n fundo moldura)
  (setq ss (ssget "_X" (list (cons 0 "MTEXT") (cons 8 "CLIVUS_STRING_PRETAG"))) i 0 n 0 fundo 0 moldura 0)
  (while (and ss (< i (sslength ss)))
    (setq d (entget (ssname ss i)) i (1+ i) n (1+ n) f (if (assoc 90 d) (cdr (assoc 90 d)) 0))
    (if (= 1 (logand f 1)) (setq fundo (1+ fundo)))
    (if (= 16 (logand f 16)) (setq moldura (1+ moldura))))
  (princ (strcat "\nCLIVUS_PRETAGF etapa=" etapa " n=" (itoa n) " fundo=" (itoa fundo) " moldura=" (itoa moldura) " fim")))
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "PreTag" "*" "1;1;1")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "SoltarUsina" ".")
(command "CLIVUS_ELETRICA_AUTO" "Atribuir")
(clivus:pretagf "tudo")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "PreTag" "*" "1;0;0")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "SoltarUsina" ".")
(command "CLIVUS_ELETRICA_AUTO" "Atribuir")
(clivus:pretagf "nua")
(command "CLIVUS_ELETRICA_JANELA_LOCAL_AUTO" "PreTag" "*" "0;1;1")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "SoltarUsina" ".")
(command "CLIVUS_ELETRICA_AUTO" "Atribuir")
(clivus:pretagf "sem")
(setvar "OSMODE" clivus:osmode)
(princ "\nCLIVUS_LOCAL_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ)
