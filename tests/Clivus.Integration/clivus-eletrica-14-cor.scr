; Nivel 2 da cor por inversor (05/10/2026): os inversores criados ganham
; cores distintas; a string alocada fica com a cor do inversor (DXF 420); ao
; soltar volta para ByLayer; trocar a cor repinta as strings dele; o formato 1
; dos inversores (sem cor) e lido com a cor automatica.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "3")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "4")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "3")
(defun clivus:inv (e) (cdr (nth 4 (cdr (cadr (assoc -3 (entget e (list "CLIVUS"))))))))
(defun clivus:c420 (e / c) (if (setq c (cdr (assoc 420 (entget e)))) (itoa c) "-1"))
(defun clivus:c62 (e / c) (if (setq c (cdr (assoc 62 (entget e)))) (itoa c) "256"))
(defun clivus:dump (etapa / ss i e)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS")))) i 0)
  (while (< i (sslength ss))
    (setq e (ssname ss i) i (1+ i))
    (princ (strcat "\nCLIVUS_STR etapa=" etapa " inv=" (clivus:inv e) " c420=" (clivus:c420 e) " c62=" (clivus:c62 e) " fim")))
  (princ (strcat "\nCLIVUS_ETAPA_FIM " etapa)))
(clivus:dump "alocadas")
(command "CLIVUS_ELETRICA_AUTO" "Cor" "Inversor 1" "#123456")
(clivus:dump "trocada")
(command "CLIVUS_ELETRICA_AUTO" "SoltarInversor" "Inversor 2")
(clivus:dump "soltas")
(command "CLIVUS_ELETRICA_AUTO" "InversoresAntigos")
(princ "\nCLIVUS_COR_ANTES_DE_REGRAVAR")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "1")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
