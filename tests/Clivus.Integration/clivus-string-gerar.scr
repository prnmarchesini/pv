; Nivel 2 do 11.6 (eletrica): a aba Gerar. Usina mista (mesas de 28 e de
; 14 por fileira); Modelo 1 de uma mesa de 28, Modelo 2 de uma de 14 e Modelo 3
; de duas de 28 vizinhas; gerar em tudo (a selecao pega o desenho inteiro:
; terreno, curvas e o resto ficam de fora). Cada tipo so cai em grupo igual.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area mista eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:mesa (rotulo / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (cdr (nth 0 xd)) "Mesa") (= (cdr (nth 3 xd)) rotulo)) (setq achada e))
    (setq i (1+ i)))
  achada)
(defun clivus:junta (lista / ss) (setq ss (ssadd)) (foreach e lista (if e (ssadd e ss))) ss)
(defun clivus:perfil (rotulo) (cdr (nth 17 (clivus:xdata (clivus:mesa rotulo)))))
(defun clivus:primeira (perfil / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (cdr (nth 0 xd)) "Mesa") (= (cdr (nth 17 xd)) perfil)) (setq achada e))
    (setq i (1+ i)))
  achada)
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) clivus:i 0)
(while (< clivus:i (sslength clivus:ss))
  (setq clivus:xd (clivus:xdata (ssname clivus:ss clivus:i)))
  (if (= (cdr (nth 0 clivus:xd)) "Mesa") (princ (strcat "\nCLIVUS_MESA " (cdr (nth 3 clivus:xd)) " " (cdr (nth 17 clivus:xd)))))
  (setq clivus:i (1+ clivus:i)))
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:primeira "Mesa 2V28"))) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 1" "FILEIRA:C:0.0.0;FILEIRA:C:0.0.1")
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:primeira "Mesa 2V14"))) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 2" "FILEIRA:L:0.0.0;FILEIRA:L:0.0.1")
(defun clivus:par28 (/ f n a b par)
  (setq f 1)
  (while (and (< f 60) (not par))
    (setq n 1)
    (while (and (< n 30) (not par))
      (setq a (strcat "F" (itoa f) "." (itoa n)) b (strcat "F" (itoa f) "." (itoa (1+ n))))
      (if (and (clivus:mesa a) (clivus:mesa b) (= (clivus:perfil a) "Mesa 2V28") (= (clivus:perfil b) "Mesa 2V28"))
        (setq par (list (clivus:mesa a) (clivus:mesa b))))
      (setq n (1+ n)))
    (setq f (1+ f)))
  par)
(command "CLIVUS_STRING_MESAS" (clivus:junta (clivus:par28)) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 3" "FILEIRA:C:0.0.0;FILEIRA:C:0.0.1")
(command "CLIVUS_STRING_GERAR" (ssget "_X") "")
(princ "\nCLIVUS_STRING_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
