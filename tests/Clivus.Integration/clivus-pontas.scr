; Teste de nivel 2 das pontas a mao (27/09/2026): processa uma fileira e
; manda a F1.2 ficar com PB 0,55 no primeiro pilar e 1,10 no ultimo
; (CLIVUS_PONTAS_AUTO). Depois trava a primeira e muda so a ultima para 0,70.
; Le do desenho, pelo XData:
;   - a F1.2 continua com UM contorno, o mesmo GUID, e 7 pilares;
;   - a altura livre da ponta baixa (campo 9 do pilar) no pilar 1 e no 7;
;   - as pontas gravadas no contorno (campos 13 e 14 da mesa).

(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area das pontas")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento das pontas")
(command "CLIVUS_FILEIRA_AUTO")
(setvar "OSMODE" clivus:osmode)

(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))

; Le a F1.2: GUID, contornos, pilares, PB do pilar 1 e do 7, pontas gravadas.
(defun clivus:ler (rotulo / tudo n i en xd guid cont pil pb1 pb7 m1 m2 v z0 z1 fecha gmin gmax chao)
  (setq tudo (ssget "_X" (list (cons -3 (list (list "CLIVUS"))))))
  (setq n (if tudo (sslength tudo) 0) i 0 guid nil cont 0 pil 0 pb1 "-" pb7 "-" m1 "-" m2 "-" z0 "-" z1 "-" fecha 0.0 gmin 1e9 gmax -1e9)
  (while (< i n)
    (setq en (ssname tudo i) xd (clivus:xdata en))
    (if (and (= (clivus:tipo xd) "Mesa") (= (clivus:campo xd 1) "F1.2"))
      (progn
        (setq guid (clivus:campo xd 0) cont (1+ cont) m1 (clivus:campo xd 13) m2 (clivus:campo xd 14))
        ; Regra 5 lida da entidade: a cota dos dois cantos da borda baixa.
        (setq v (entnext en) z0 (rtos (cadddr (assoc 10 (entget v))) 2 4))
        (setq v (entnext v) z1 (rtos (cadddr (assoc 10 (entget v))) 2 4))))
    (setq i (1+ i)))
  (setq i 0)
  (while (< i n)
    (setq en (ssname tudo i) xd (clivus:xdata en))
    (if (and guid (= (clivus:tipo xd) "Pilar") (= (clivus:campo xd 1) guid))
      (progn
        (setq pil (1+ pil))
        ; topo (geometria) - terreno (gravado) tem que dar a altura livre.
        (setq chao (atof (clivus:campo xd 8)))
        (setq gmin (min gmin chao) gmax (max gmax chao))
        (setq fecha (max fecha (abs (- (- (cadddr (assoc 10 (entget en))) chao) (atof (clivus:campo xd 6))))))
        (if (= (clivus:campo xd 2) "1") (setq pb1 (clivus:campo xd 9)))
        (if (= (clivus:campo xd 2) "7") (setq pb7 (clivus:campo xd 9)))))
    (setq i (1+ i)))
  (princ (strcat "\nCLIVUS_PONTAS_COTA " rotulo " z0=" z0 " z1=" z1 " chaoMin=" (rtos gmin 2 4) " chaoMax=" (rtos gmax 2 4) " fecha=" (rtos fecha 2 6)))
  (princ (strcat "\nCLIVUS_PONTAS_LISP " rotulo " guid=" (if guid guid "-") " cont=" (itoa cont) " pilares=" (itoa pil)
                 " pb1=" (if pb1 pb1 "-") " pb7=" (if pb7 pb7 "-") " m1=" (if m1 m1 "-") " m2=" (if m2 m2 "-"))))

(clivus:ler "antes")
(command "CLIVUS_PONTAS_AUTO" "F1.2" "0.55" "1.10")
(clivus:ler "duas")
(command "CLIVUS_PONTAS_AUTO" "F1.2" "" "0.70")
(clivus:ler "travada")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
