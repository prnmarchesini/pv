; Nivel 2 do 12.2 (eletrica): subestacoes unitarias, cada uma com o seu trafo.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "1")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "1")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "1")
(command "CLIVUS_ELETRICA_AUTO" "Uc" "Unitarias" "2")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "U1" "T1")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "U2" "T2")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "U1" "T3")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
