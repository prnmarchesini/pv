; Teste de nivel 2 dos estilos do projeto (passo 8.13). Sem escolha
; gravada, os textos do plugin saem no estilo de texto do Renan quando o
; desenho o tem (anotativo); escolhido o Standard, saem nele, sem ser
; anotativos. Le o estilo (grupo 7), o anotativo e a altura da entidade.

(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area dos estilos")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento dos estilos")
(command "CLIVUS_FILEIRA_AUTO")
(setvar "OSMODE" clivus:osmode)

(defun clivus:primeiro ( / ss)
  (setq ss (ssget "_X" (list (cons 0 "MTEXT") (cons 8 "CLIVUS_TXT_PONTA_BAIXA"))))
  (if ss (ssname ss 0)))
; Sem getpropertyvalue no Core Console: o anotativo se le pelo XData
; AcadAnnotative, que o AutoCAD grava em todo objeto anotativo.
(defun clivus:descrever (rotulo e / d)
  (setq d (entget e '("AcadAnnotative")))
  (princ (strcat "\n" rotulo " estilo=" (cdr (assoc 7 d))
                 " anotativo=" (if (assoc -3 d) "1" "0")
                 " altura=" (rtos (cdr (assoc 40 d)) 2 4))))

(command "CLIVUS_AN_PB_INSERIR")
(clivus:descrever "CLIVUS_ESTILO_PADRAO" (clivus:primeiro))
(command "CLIVUS_ESTILOS_AUTO" "Standard" "-" "-")
(command "CLIVUS_AN_PB_INSERIR")
(clivus:descrever "CLIVUS_ESTILO_STANDARD" (clivus:primeiro))
(princ (strcat "\nCLIVUS_ESTILO_CANNOSCALE " (getvar "CANNOSCALE")))
(setvar "SECURELOAD" clivus:secureload)
(princ)
