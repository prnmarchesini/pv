; Nivel 2 do botao Selecionar da aba Inversor (reprovacao de 05/10/2026: "o
; botao selecionar nao faz nada"). O gancho chama o MESMO caminho do botao,
; fora de comando; depois a selecao implicita e lida com (ssget "_I"): tem
; que ter so as strings do inversor, todas, e nada mais.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "2")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "5")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "3")
(defun clivus:inv (e) (cdr (nth 4 (cdr (cadr (assoc -3 (entget e (list "CLIVUS"))))))))
(defun clivus:conta (ss inv / i n) (setq i 0 n 0) (if ss (while (< i (sslength ss)) (if (= (clivus:inv (ssname ss i)) inv) (setq n (1+ n))) (setq i (1+ i)))) n)
(sssetfirst nil nil)
(command "CLIVUS_ELETRICA_JANELA_SELECIONAR_AUTO" "Inversor 1")
(setq clivus:impl (ssget "_I"))
(setq clivus:inv1 (if clivus:impl (clivus:inv (ssname clivus:impl 0)) ""))
(princ (strcat "\nCLIVUS_JANELA_SEL n=" (itoa (if clivus:impl (sslength clivus:impl) 0)) " dele=" (itoa (clivus:conta clivus:impl clivus:inv1))
               " todas_dele=" (itoa (clivus:conta (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS")))) clivus:inv1)) " fim"))
(sssetfirst nil nil)
(command "CLIVUS_ELETRICA_JANELA_SELECIONAR_AUTO" "Inversor 2")
(setq clivus:impl (ssget "_I"))
(princ (strcat "\nCLIVUS_JANELA_SEL2 n=" (itoa (if clivus:impl (sslength clivus:impl) 0)) " do1=" (itoa (clivus:conta clivus:impl clivus:inv1)) " fim"))
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
