; Nivel 2 do Apagar da Edicao (05/10/2026): usina mista, strings de verdade
; (com os sinais + e -), a cadeia de exemplo (UC, 2 trafos, 4 inversores,
; strings alocadas), a cor do Inversor 1, as tags da numeracao, tres
; equipamentos em campo, textos de analise (ponta baixa e declividade) com a
; pintura de todos os modulos, tags das mesas, uma mesa pendente, uma arvore e
; a sombra das 09:00. Quatro entidades do usuario (duas em camadas CLIVUS_*,
; sem o nosso XData). O LISP conta tudo LIDO DO DESENHO (XData, cor e
; dicionario) antes e depois de cada CLIVUS_APAGAR; quem confere e o runner.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area apagar")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento apagar")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")

(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))
(defun clivus:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun clivus:junta (lista / ss) (setq ss (ssadd)) (foreach e lista (if e (ssadd e ss))) ss)
(defun clivus:primeira (perfil / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (clivus:tipo xd) "Mesa") (= (clivus:campo xd 15) perfil)) (setq achada e))
    (setq i (1+ i)))
  achada)
(defun clivus:verts (e / v l)
  (setq v (entnext e))
  (while (and v (= (cdr (assoc 0 (entget v))) "VERTEX"))
    (setq l (cons (cdr (assoc 10 (entget v))) l) v (entnext v)))
  l)

; Strings de verdade: Modelo 1 (uma de 28) e Modelo 2 (uma de 14), gerar em tudo.
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:primeira "Mesa 2V28"))) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 1" "FILEIRA:C:0.0.0;FILEIRA:C:0.0.1")
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:primeira "Mesa 2V14"))) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 2" "FILEIRA:L:0.0.0;FILEIRA:L:0.0.1")
(command "CLIVUS_STRING_GERAR" (ssget "_X") "")

; A cadeia, a cor de um inversor, as tags e os equipamentos em campo.
(command "CLIVUS_NUMERACAO_EXEMPLO_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Cor" "Inversor 1" "#123456")
; As tags com fundo e moldura (05/10/2026): o Apagar tem que acha-las do mesmo jeito.
(command "CLIVUS_NUMERACAO_AUTO" "Fundo" "Sim")
(command "CLIVUS_NUMERACAO_AUTO" "Moldura" "Sim")
(command "CLIVUS_NUMERACAO_AUTO" "Gerar")
(command "CLIVUS_ELETRICA_POSICIONAR" "C1" "{{P1}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 1" "{{P2}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "TA" "{{P3}}")
(command "CLIVUS_ELETRICA_JANELA_HATCH_AUTO" "*")

; Analises (textos e a pintura de todo modulo), tags, uma mesa pendente.
(command "CLIVUS_AN_PB_INSERIR")
(command "CLIVUS_AN_DECL_INSERIR")
(command "CLIVUS_AN_TESTE_PECAS")
(command "CLIVUS_TAG_MESAS")
(command "CLIVUS_PENDENTE_AUTO")

; A arvore no meio da primeira mesa de 28 e a sombra das 09:00.
(setq clivus:v (clivus:verts (clivus:primeira "Mesa 2V28")))
(setq clivus:meio (list (/ (apply '+ (mapcar 'car clivus:v)) (length clivus:v)) (/ (apply '+ (mapcar 'cadr clivus:v)) (length clivus:v)) 0.0))
(command "CLIVUS_ARVORE_AUTO" 4 0.6 10 8 clivus:meio "")
(command "CLIVUS_SOMBRAS_AUTO" "21/06/2026" "21/06/2026" "09:00" "09:00" "30" "-3" "1")
(setvar "OSMODE" clivus:osmode)

; As entidades do usuario: duas em camadas do plugin, sem o nosso XData.
(setq clivus:x (car clivus:meio) clivus:y (cadr clivus:meio) clivus:usuario nil)
(defun clivus:guarda (/ e d) (setq e (entlast) d (entget e))
  (setq clivus:usuario (cons (list (cdr (assoc 5 d)) (cdr (assoc 0 d)) (if (assoc 62 d) (cdr (assoc 62 d)) 256)) clivus:usuario)))
(entmake (list '(0 . "LINE") '(8 . "0") '(62 . 1) (list 10 clivus:x clivus:y 0.0) (list 11 (+ clivus:x 30.0) clivus:y 0.0)))
(clivus:guarda)
(entmake (list '(0 . "MTEXT") '(100 . "AcDbEntity") '(8 . "CLIVUS_STRING") '(100 . "AcDbMText") (list 10 clivus:x (+ clivus:y 5.0) 0.0) '(40 . 1.0) '(1 . "texto do usuario")))
(clivus:guarda)
(entmake (list '(0 . "TEXT") '(8 . "CLIVUS_SOMBRA_TEXTO") '(62 . 3) (list 10 clivus:x (+ clivus:y 8.0) 0.0) '(40 . 1.0) '(1 . "usuario")))
(clivus:guarda)
(entmake (list '(0 . "CIRCLE") '(8 . "CLIVUS_STRING") (list 10 clivus:x (+ clivus:y 11.0) 0.0) '(40 . 0.45)))
(clivus:guarda)

; ---------------------------------------------------------------- a contagem
(defun clivus:rgb (d) (if (assoc 420 d) (cdr (assoc 420 d)) -1))
(defun clivus:cor (d) (strcat (itoa (if (assoc 62 d) (cdr (assoc 62 d)) 256)) "/" (if (assoc 420 d) (itoa (cdr (assoc 420 d))) "-")))
(defun clivus:inc (k / p)
  (if (setq p (assoc k clivus:cnt))
    (setq clivus:cnt (subst (cons k (1+ (cdr p))) p clivus:cnt))
    (setq clivus:cnt (cons (cons k 1) clivus:cnt))))
(defun clivus:get (k) (if (assoc k clivus:cnt) (cdr (assoc k clivus:cnt)) 0))
(defun clivus:dic (chave / d) (setq d (dictsearch (namedobjdict) "CLIVUS")) (if d (dictsearch (cdr (assoc -1 d)) chave)))
(defun clivus:textos (chave / x l) (setq x (clivus:dic chave)) (foreach p x (if (= (car p) 1) (setq l (cons (cdr p) l)))) (reverse l))
; A quantidade gravada no cabecalho do registro (o 4o texto); "-" sem registro.
(defun clivus:reg (chave / l) (if (clivus:dic chave) (progn (setq l (clivus:textos chave)) (if (>= (length l) 4) (nth 3 l) "?")) "-"))
(defun clivus:defs (/ b n) (setq n 0 b (tblnext "BLOCK" T))
  (while b (if (wcmatch (strcase (cdr (assoc 2 b))) "CLIVUS_EQUIPAMENTO_*") (setq n (1+ n))) (setq b (tblnext "BLOCK")))
  n)
(defun clivus:vivos (/ n d)
  (setq n 0)
  (foreach u clivus:usuario
    (setq d (if (handent (car u)) (entget (handent (car u)))))
    (if (and d (= (cdr (assoc 0 d)) (cadr u)) (= (if (assoc 62 d) (cdr (assoc 62 d)) 256) (caddr u))) (setq n (1+ n))))
  n)

; A peca fora da camada original dela (a analise do desenho a levava para a dela).
(defun clivus:camada (d esperada) (if (/= (strcase (cdr (assoc 8 d))) esperada) (clivus:inc "foracamada")))
(defun clivus:dump (etapa / ss i e d xd tp mesas cor marc perfis p)
  (setq clivus:cnt nil mesas nil ss (ssget "_X" '((-3 ("CLIVUS")))) i 0)
  (while (< i (clivus:conta ss))
    (setq e (ssname ss i) d (entget e '("CLIVUS")) xd (cdr (car (cdr (assoc -3 d)))) tp (clivus:tipo xd) cor (clivus:cor d) i (1+ i))
    (clivus:inc tp)
    (cond
      ((= tp "Mesa")
       (setq mesas (cons (list (clivus:campo xd 0) cor (clivus:campo xd 5)) mesas))
       (clivus:camada d (if (= (clivus:campo xd 5) "1") "CLIVUS_MARCADA" "CLIVUS_MESA"))
       ; Mesas que cabem, do mesmo tipo: o contorno com a mesma cor.
       (if (= (clivus:campo xd 5) "0")
         (if (setq p (assoc (clivus:campo xd 15) perfis))
           (if (/= (cdr p) cor) (clivus:inc "perfildiverso"))
           (setq perfis (cons (cons (clivus:campo xd 15) cor) perfis))))
       (if (= (clivus:rgb d) 16711680) (clivus:inc "contvermelho")))
      ((= tp "Modulo")
       (if (member (clivus:rgb d) '(14136575 10509030 6231200)) (clivus:inc "modsombra"))
       (if (= (clivus:rgb d) 16711680) (clivus:inc "modvermelho")))
      ((= tp "String")
       (if (/= (clivus:campo xd 2) "") (clivus:inc "alocadas"))
       (if (/= (clivus:campo xd 3) "") (clivus:inc "comtag"))
       (if (/= cor "256/-") (clivus:inc "strpintadas")))
      ((= tp "SinalString") (if (/= cor "256/-") (clivus:inc "sinpintados")))
      ((= tp "TextoAnalise") (if (/= cor "256/-") (clivus:inc "anpintados")))))
  ; Modulo com cor diferente do contorno da mesa dele; pilar pintado em mesa que cabe.
  (setq i 0)
  (while (< i (clivus:conta ss))
    (setq e (ssname ss i) d (entget e '("CLIVUS")) xd (cdr (car (cdr (assoc -3 d)))) tp (clivus:tipo xd) i (1+ i))
    (if (member tp '("Modulo" "Pilar"))
      (progn
        (setq marc (assoc (clivus:campo xd 1) mesas))
        (if marc (clivus:camada d (if (= (caddr marc) "1") "CLIVUS_MARCADA" (if (= tp "Modulo") "CLIVUS_MODULO" "CLIVUS_PILAR"))))
        (if (and (= tp "Modulo") marc (/= (clivus:cor d) (cadr marc))) (clivus:inc "desiguais"))
        (if (and (= tp "Pilar") marc (= (caddr marc) "0") (/= (clivus:cor d) "256/-")) (clivus:inc "pilpintados")))))
  (princ (strcat "\nCLIVUS_APAGAR_DUMP etapa=" etapa))
  (foreach k '("Mesa" "Modulo" "Pilar" "Face" "Nota" "TextoAnalise" "Tag" "StringTag" "SinalString" "String" "Sombra" "Equipamento" "AreaDoTrafo"
               "Arvore" "Area" "Alinhamento" "contvermelho" "modsombra" "modvermelho" "alocadas" "comtag" "strpintadas" "sinpintados"
               "anpintados" "desiguais" "pilpintados" "foracamada" "perfildiverso")
    (princ (strcat " " k "=" (itoa (clivus:get k)))))
  (princ (strcat " inv=" (clivus:reg "INVERSORES") " trafos=" (clivus:reg "TRAFOS") " ucs=" (clivus:reg "SUBESTACOES")
                 " modelos=" (clivus:reg "INVERSOR_MODELOS") " defs=" (itoa (clivus:defs))
                 " sombrapint=" (itoa (length (clivus:textos "SOMBRA_PINTADAS"))) " motivos=" (itoa (length (clivus:textos "SOMBRA_MOTIVOS")))
                 " anpint=" (itoa (length (clivus:textos "PINTADAS_LOWEDGE")))
                 " tipos=" (if (clivus:dic "STRING_TIPOS") "1" "0")
                 " usuario=" (itoa (clivus:vivos)) " fim"))
  (princ))

(clivus:dump "inicio")
(command "CLIVUS_APAGAR" "12345")
(clivus:dump "tudo")
(command "_.U")
(clivus:dump "desfeito")
(command "CLIVUS_APAGAR" "3")
(clivus:dump "sombras")
(command "CLIVUS_APAGAR" "1")
(clivus:dump "cores")
(command "CLIVUS_APAGAR" "5")
(clivus:dump "infra")
(command "CLIVUS_APAGAR" "2")
(clivus:dump "textos")
(command "CLIVUS_APAGAR" "4")
(clivus:dump "strings")
(command "CLIVUS_APAGAR" "9")
(princ "\nCLIVUS_APAGAR_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
