; Nivel 2 da atribuicao automatica das strings nos inversores (05/10/2026):
; a varredura propria da atribuicao (separada da numeracao); as livres enchem
; os inversores na ordem da lista ate o total de entradas; as ja alocadas
; contam; inversor cheio e pulado; a sobra e avisada; as strings ficam com a
; cor do inversor. Conferido pelo XData (o vinculo) e pelo 420 (a cor).
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Pequeno" "2" "3;4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Pequeno" "3")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "2")
(command "CLIVUS_ELETRICA_AUTO" "Varredura" "TopToBottom" "TopToBottom")
(command "CLIVUS_ELETRICA_AUTO" "Varredura" "TopToBottom" "LeftToRight")
(defun clivus:inv (e) (cdr (nth 4 (cdr (cadr (assoc -3 (entget e (list "CLIVUS"))))))))
(defun clivus:c420 (e / c) (if (setq c (cdr (assoc 420 (entget e)))) (itoa c) "-1"))
(defun clivus:p1 (e / d) (setq d (cdr (assoc 10 (entget (entnext e))))) (strcat (rtos (car d) 2 3) " y=" (rtos (cadr d) 2 3)))
(defun clivus:dump (etapa / ss i e)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS")))) i 0)
  (while (< i (sslength ss))
    (setq e (ssname ss i) i (1+ i))
    (princ (strcat "\nCLIVUS_STR etapa=" etapa " h=" (cdr (assoc 5 (entget e))) " inv=" (clivus:inv e) " c420=" (clivus:c420 e) " x=" (clivus:p1 e) " fim")))
  (princ (strcat "\nCLIVUS_ETAPA_FIM " etapa)))
(clivus:dump "antes")
(command "CLIVUS_ELETRICA_AUTO" "Atribuir")
(clivus:dump "cima")
(command "CLIVUS_ELETRICA_AUTO" "Atribuir")
(princ "\nCLIVUS_SEGUNDA_FIM")
(command "CLIVUS_ELETRICA_AUTO" "SoltarInversor" "Inversor 1")
(command "CLIVUS_ELETRICA_AUTO" "SoltarInversor" "Inversor 2")
(command "CLIVUS_ELETRICA_AUTO" "SoltarInversor" "Inversor 3")
(command "CLIVUS_ELETRICA_AUTO" "Varredura" "BottomToTop" "RightToLeft")
(command "CLIVUS_ELETRICA_AUTO" "Atribuir")
(clivus:dump "baixo")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
