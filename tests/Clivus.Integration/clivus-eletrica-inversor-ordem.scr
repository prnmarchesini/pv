; Nivel 2 da aba Inversor de 10/10/2026, pelo mesmo caminho da janela
; (contexto da aplicacao, fora de comando): o Soltar da linha e o "Soltar
; todas da usina" apagam as tags das strings soltas (os textos saem e o campo
; Tag fica vazio); a ordem da lista (Ordenar por Nome, por Trafo, por Trafo e
; Nome, e o arrastar da linha) e gravada e lida de volta; o "Apagar todos"
; leva todos os inversores e as tags das strings deles.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area eletrica")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento eletrica")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "4")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "5")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "3")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 3" "2")
(command "CLIVUS_ELETRICA_JANELA_TRAFO_AUTO" "Inversor 2;Inversor 4" "T2")
(command "CLIVUS_ELETRICA_JANELA_TRAFO_AUTO" "Inversor 3" "T1")

(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))
(defun clivus:textos (fase / ss i n)
  (setq ss (ssget "_X" (list (cons 0 "MTEXT") (list -3 (list "CLIVUS")))) i 0 n 0)
  (while (< i (clivus:conta ss))
    (if (= (clivus:tipo (clivus:xdata (ssname ss i))) "StringTag") (setq n (1+ n)))
    (setq i (1+ i)))
  (princ (strcat "\nCLIVUS_ORDEM_TEXTOS fase=" fase " textos=" (itoa n))))

; ---- Soltar apaga as tags
(command "CLIVUS_NUMERACAO_AUTO" "Gerar")
(clivus:textos "gerou")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 1" "Soltar" ".")
(clivus:textos "soltou1")
(command "CLIVUS_NUMERACAO_AUTO" "Strings")
(princ "\nCLIVUS_ORDEM_SOLTOU1")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "SoltarUsina" ".")
(clivus:textos "soltouusina")
(command "CLIVUS_NUMERACAO_AUTO" "Strings")
(princ "\nCLIVUS_ORDEM_SOLTOUUSINA")

; ---- a ordem: o caso do Renan (nao tem o Inversor 1; o criado sai Inversor 5 e e renomeado)
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 1" "Apagar" ".")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "1")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 5" "Nome" "Inversor 1")
(command "CLIVUS_ELETRICA_JANELA_TABELA_AUTO")
(princ "\nCLIVUS_ORDEM_CRIADO")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "Ordenar" "Nome")
(command "CLIVUS_ELETRICA_JANELA_TABELA_AUTO")
(princ "\nCLIVUS_ORDEM_NOME")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "Ordenar" "Nome")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 4" "Mover" "Inversor 1")
(command "CLIVUS_ELETRICA_JANELA_TABELA_AUTO")
(princ "\nCLIVUS_ORDEM_SUBIU")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "Ordenar" "Trafo")
(command "CLIVUS_ELETRICA_JANELA_TABELA_AUTO")
(princ "\nCLIVUS_ORDEM_TRAFO")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "Ordenar" "TrafoNome")
(command "CLIVUS_ELETRICA_JANELA_TABELA_AUTO")
(princ "\nCLIVUS_ORDEM_TRAFONOME")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 3" "Mover" "Inversor 1")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "Inversor 3" "Mover" "Nenhum")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "Ordenar" "Cor")
(command "CLIVUS_ELETRICA_JANELA_TABELA_AUTO")
(princ "\nCLIVUS_ORDEM_DESCEU")

; ---- Apagar todos leva as tags
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "3")
(command "CLIVUS_NUMERACAO_AUTO" "Gerar")
(clivus:textos "gerou2")
(command "CLIVUS_ELETRICA_JANELA_LINHA_AUTO" "*" "Apagar" ".")
(clivus:textos "apagoutodos")
(command "CLIVUS_ELETRICA_AUTO" "Listar")
(princ "\nCLIVUS_ELETRICA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
