; Teste de nivel 2 das sombras no periodo (05/10/2026 e 42.1): o dia inteiro
; com a arvore fora da fileira desenha a mancha de todos os passos (hachura e
; borda magenta, a borda com os dentes dos passos); o "Por que essa sombra?"
; de um modulo com sombra (o primeiro do registro dos motivos, pelo gancho
; clivus-sombras-modulos, so no build Debug) diz quanto, por que e quando; o
; de um modulo sem sombra, que nao tem; as analises (CLIVUS_SOMBRAS_ANALISES_AUTO)
; listam os topicos area > mesa > modulo; e o ano com o sol acima de 20 graus.

(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area sombras")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento sombras")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:verts (e / v l)
  (setq v (entnext e))
  (while (and v (= (cdr (assoc 0 (entget v))) "VERTEX"))
    (setq l (cons (cdr (assoc 10 (entget v))) l) v (entnext v)))
  l)
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) clivus:i 0 clivus:meio nil)
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:e (ssname clivus:ss clivus:i) clivus:xd (clivus:xdata clivus:e))
  (if (and (= (cdr (nth 0 clivus:xd)) "Mesa") (= (cdr (nth 3 clivus:xd)) "F1.3"))
    (setq clivus:v (clivus:verts clivus:e)))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:meio (list (/ (apply '+ (mapcar 'car clivus:v)) 4.0) (/ (apply '+ (mapcar 'cadr clivus:v)) 4.0) 0.0))
(setq clivus:a (mapcar '- (nth 1 clivus:v) (nth 0 clivus:v)) clivus:b (mapcar '- (nth 2 clivus:v) (nth 1 clivus:v)))
(defun clivus:len (u) (sqrt (+ (* (car u) (car u)) (* (cadr u) (cadr u)))))
(setq clivus:curto (if (< (clivus:len clivus:a) (clivus:len clivus:b)) clivus:a clivus:b))
(setq clivus:w (clivus:len clivus:curto) clivus:k (* 1 (/ (+ (/ clivus:w 2.0) 3.0) clivus:w)))
(setq clivus:pe (list (+ (car clivus:meio) (* clivus:k (car clivus:curto))) (+ (cadr clivus:meio) (* clivus:k (cadr clivus:curto))) 0.0))
(command "CLIVUS_ARVORE_AUTO" 4 0.6 10 8 clivus:pe "")
(setvar "OSMODE" clivus:osmode)

; As entidades de sombra de um tipo ("HATCH" ou "POLYLINE").
(defun clivus:sombras (tipo / ss i e l)
  (setq ss (ssget "_X" (list (cons 0 tipo) (list -3 (list "CLIVUS")))) i 0 l nil)
  (while (< i (clivus:conta ss))
    (setq e (ssname ss i))
    (if (= (cdr (nth 0 (clivus:xdata e))) "Sombra") (setq l (cons e l)))
    (setq i (1+ i)))
  l)
; Quantos vertices (o 10 do contorno, entre o 91 e o 75) tem a maior hachura.
(defun clivus:nvh (e / dentro n)
  (setq dentro nil n 0)
  (foreach g (entget e)
    (cond ((= (car g) 91) (setq dentro T))
          ((= (car g) 75) (setq dentro nil))
          ((and dentro (= (car g) 10)) (setq n (1+ n)))))
  n)

(command "CLIVUS_SOMBRAS_AUTO" "21/06/2026" "21/06/2026" "06:00" "18:00" "60" "-3" "1")
(setq clivus:comsombra (clivus-sombras-modulos) clivus:marcado (car clivus:comsombra))

; Um modulo sem sombra: o primeiro bloco de modulo que nao esta no registro.
(setq clivus:ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_MOD*"))) clivus:i 0 clivus:limpo nil)
(while (and (null clivus:limpo) (< clivus:i (clivus:conta clivus:ss)))
  (setq clivus:h (cdr (assoc 5 (entget (ssname clivus:ss clivus:i)))))
  (if (not (member clivus:h clivus:comsombra)) (setq clivus:limpo clivus:h))
  (setq clivus:i (1+ clivus:i)))

(setq clivus:bordas 0 clivus:maior 0)
(foreach e (clivus:sombras "POLYLINE") (setq clivus:bordas (+ clivus:bordas (length (clivus:verts e)))))
(foreach e (clivus:sombras "HATCH") (setq clivus:maior (max clivus:maior (clivus:nvh e))))
(princ (strcat "\nCLIVUS_PORQUE hachuras=" (itoa (length (clivus:sombras "HATCH"))) " marcado=" (if clivus:marcado clivus:marcado "-") " limpo=" (if clivus:limpo clivus:limpo "-")))
(princ (strcat "\nCLIVUS_PORQUE_VERTICES bordas=" (itoa clivus:bordas) " maior=" (itoa clivus:maior)))
(princ "\nCLIVUS_PORQUE_MARCADO")
(if clivus:marcado (command "CLIVUS_SOMBRA_PORQUE_AUTO" clivus:marcado))
(princ "\nCLIVUS_PORQUE_LIMPO")
(if clivus:limpo (command "CLIVUS_SOMBRA_PORQUE_AUTO" clivus:limpo))
(princ "\nCLIVUS_PORQUE_ANALISES")
(command "CLIVUS_SOMBRAS_ANALISES_AUTO")
(princ "\nCLIVUS_PORQUE_ALTURA")
(command "CLIVUS_SOMBRAS_AUTO" "01/01/2026" "31/12/2026" ">20" "23:59" "60" "-3" "30")
(princ "\nCLIVUS_PORQUE_JANELA_E_ALTURA")
(command "CLIVUS_SOMBRAS_AUTO" "01/01/2026" "31/12/2026" "08:00>30" "10:00" "60" "-3" "30")
(princ "\nCLIVUS_PORQUE_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
