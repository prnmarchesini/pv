; Teste de nivel 2 do 15.4 (eletrica): gerar as tags. Usina pelo motor,
; strings de teste e a cadeia de exemplo (4 inversores, 14 strings alocadas).
; Fase 1: a usina inteira da esquerda para a direita, sem blocos. Fase 2: dois
; blocos (oeste de baixo para cima, leste da direita para a esquerda) com o
; leste subido para o topo da lista. Em cada fase o LISP le os textos das
; tags (XData StringTag): quantos, se escrevem a tag gravada na string, a
; camada e a cota.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area numeracao")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento numeracao")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_NUMERACAO_EXEMPLO_AUTO")

(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))
(defun clivus:x0 (e) (cadr (assoc 10 (entget (entnext e)))))

; Le os textos de tag e confere contra a tag gravada na string.
(defun clivus:textos (fase / ss i e xd tags n iguais camada zmin zmax z)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0 tags nil)
  (while (< i (clivus:conta ss))
    (setq xd (clivus:xdata (ssname ss i)))
    (if (= (clivus:tipo xd) "String") (setq tags (cons (cons (clivus:campo xd 0) (clivus:campo xd 3)) tags)))
    (setq i (1+ i)))
  (setq ss (ssget "_X" (list (cons 0 "MTEXT") (list -3 (list "CLIVUS")))) i 0 n 0 iguais 0 camada 0 zmin 1e99 zmax -1e99)
  (while (< i (clivus:conta ss))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (= (clivus:tipo xd) "StringTag")
      (progn
        (setq n (1+ n) z (cadddr (assoc 10 (entget e))))
        (setq zmin (min zmin z) zmax (max zmax z))
        (if (and (= (cdr (assoc 1 (entget e))) (clivus:campo xd 1))
                 (= (cdr (assoc (clivus:campo xd 0) tags)) (clivus:campo xd 1)))
          (setq iguais (1+ iguais)))
        (if (= (cdr (assoc 8 (entget e))) "CLIVUS_STRING_TAG") (setq camada (1+ camada)))))
    (setq i (1+ i)))
  (princ (strcat "\nCLIVUS_NUMERACAO_TEXTOS fase=" fase " textos=" (itoa n) " iguais=" (itoa iguais) " camada=" (itoa camada)
                 " zmin=" (rtos zmin 2 3) " zmax=" (rtos zmax 2 3))))

(princ "\nCLIVUS_FASE 1")
(command "CLIVUS_NUMERACAO_AUTO" "Gerar")
(command "CLIVUS_NUMERACAO_AUTO" "Strings")
(clivus:textos "1")

; Os blocos: mesas a oeste e a leste da media do primeiro vertice do contorno.
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) clivus:i 0 clivus:mesas nil)
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:e (ssname clivus:ss clivus:i))
  (if (= (clivus:tipo (clivus:xdata clivus:e)) "Mesa") (setq clivus:mesas (cons clivus:e clivus:mesas)))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:media (/ (apply '+ (mapcar 'clivus:x0 clivus:mesas)) (max 1 (length clivus:mesas))))
(setq clivus:oeste (ssadd) clivus:leste (ssadd))
(foreach e clivus:mesas
  (if (< (clivus:x0 e) clivus:media) (setq clivus:oeste (ssadd e clivus:oeste)) (setq clivus:leste (ssadd e clivus:leste))))
(command "CLIVUS_NUMERACAO_AUTO" "Bloco" "Novo")
(command "CLIVUS_NUMERACAO_AUTO" "Bloco" "Novo")
(command "CLIVUS_NUMERACAO_AUTO" "Bloco" "Mesas" "Bloco 1" clivus:oeste "")
(command "CLIVUS_NUMERACAO_AUTO" "Bloco" "Mesas" "Bloco 2" clivus:leste "")
(command "CLIVUS_NUMERACAO_AUTO" "Bloco" "Sentido" "Bloco 1" "BaixoCima")
(command "CLIVUS_NUMERACAO_AUTO" "Bloco" "Sentido" "Bloco 2" "DireitaEsquerda")
(command "CLIVUS_NUMERACAO_AUTO" "Bloco" "Subir" "Bloco 2")

(princ "\nCLIVUS_FASE 2")
(command "CLIVUS_NUMERACAO_AUTO" "Gerar")
(command "CLIVUS_NUMERACAO_AUTO" "Strings")
(clivus:textos "2")
(command "CLIVUS_NUMERACAO_AUTO" "Listar")

(princ "\nCLIVUS_NUMERACAO_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
