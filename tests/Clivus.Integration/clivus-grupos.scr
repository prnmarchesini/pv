; Teste de nivel 2 do 7.9: processa uma fileira, cria o grupo "Bloco A"
; com as mesas F1.1 e F1.2 (pela selecao previa), lista os grupos (2
; mesas, 56 modulos, 14 pilares, 40,3 kWp), suja a F1.1 e recalcula o
; grupo (2 de 2, e ESTADO sem suja), seleciona o grupo (as entidades das
; duas mesas, contadas depois do recalcular), apaga a F1.1 (a lista diz
; que 1 nao esta mais no desenho e selecionar da so a F1.2) e apaga o
; registro do grupo pelo nome em minusculas (as mesas ficam).
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area dos grupos")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento dos grupos")
(command "CLIVUS_FILEIRA_AUTO")
(setvar "OSMODE" clivus:osmode)
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))
(defun clivus:mesa (xd) (cond ((= (clivus:tipo xd) "Mesa") (clivus:campo xd 0)) ((= (clivus:tipo xd) "Face") (clivus:campo xd 2)) (T (clivus:campo xd 1))))
(setq clivus:tudo (ssget "_X" (list (cons -3 (list (list "CLIVUS"))))))
(setq clivus:n (if clivus:tudo (sslength clivus:tudo) 0))
(setq clivus:g1 nil clivus:g2 nil clivus:i 0)
(while (< clivus:i clivus:n)
  (setq clivus:xd (clivus:xdata (ssname clivus:tudo clivus:i)))
  (if (= (clivus:tipo clivus:xd) "Mesa")
    (progn (if (= (clivus:campo clivus:xd 1) "F1.1") (setq clivus:g1 (clivus:campo clivus:xd 0)))
           (if (= (clivus:campo clivus:xd 1) "F1.2") (setq clivus:g2 (clivus:campo clivus:xd 0)))))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:ss (ssadd) clivus:i 0)
(while (< clivus:i clivus:n)
  (setq clivus:en (ssname clivus:tudo clivus:i) clivus:m (clivus:mesa (clivus:xdata clivus:en)))
  (if (or (= clivus:m clivus:g1) (= clivus:m clivus:g2)) (ssadd clivus:en clivus:ss))
  (setq clivus:i (1+ clivus:i)))
(defun clivus:pecas (g / tudo n i ss en)
  (setq tudo (ssget "_X" (list (cons -3 (list (list "CLIVUS"))))) ss (ssadd) i 0 n (if tudo (sslength tudo) 0))
  (while (< i n)
    (setq en (ssname tudo i))
    (if (= (clivus:mesa (clivus:xdata en)) g) (ssadd en ss))
    (setq i (1+ i)))
  ss)
(defun clivus:marcas ( / ss) (setq ss (ssget "_X" (list (cons 8 "CLIVUS_GRUPO") (cons -3 (list (list "CLIVUS")))))) (if ss (sslength ss) 0))
(sssetfirst nil clivus:ss)
(command "CLIVUS_GRUPO_CRIAR" "Bloco A")
(setq clivus:marcaCriada (clivus:marcas))
; 02/10/2026: a hachura por cima dos modulos. A cota dela (grupo 10 da
; HATCH) contra o vertice mais alto dos contornos 3D das mesas.
; So os contornos das duas mesas do grupo.
(defun clivus:zmesa (ss / i e z)
  (setq i 0 z -1e99)
  (while (< i (if ss (sslength ss) 0))
    (if (= (cdr (assoc 0 (entget (ssname ss i)))) "POLYLINE")
      (progn
        (setq e (entnext (ssname ss i)))
        (while (and e (= (cdr (assoc 0 (entget e))) "VERTEX"))
          (setq z (max z (cadddr (assoc 10 (entget e)))) e (entnext e)))))
    (setq i (1+ i)))
  z)
(defun clivus:zmesas () (max (clivus:zmesa (clivus:pecas clivus:g1)) (clivus:zmesa (clivus:pecas clivus:g2))))
(defun clivus:zhachura ( / ss) (setq ss (ssget "_X" (list (cons 0 "HATCH") (cons 8 "CLIVUS_GRUPO")))) (if ss (cadddr (assoc 10 (entget (ssname ss 0)))) -1e99))
(setq clivus:zh (clivus:zhachura) clivus:zm (clivus:zmesas))
(command "CLIVUS_GRUPOS")
(command "CLIVUS_SUJAR_AUTO")
(command "CLIVUS_GRUPO_RECALCULAR" "Bloco A")
(command "CLIVUS_ESTADO")
(setq clivus:depois (+ (sslength (clivus:pecas clivus:g1)) (sslength (clivus:pecas clivus:g2))))
(command "CLIVUS_GRUPO_SELECIONAR" "Bloco A")
(setq clivus:so2 (sslength (clivus:pecas clivus:g2)))
(command "_.ERASE" (clivus:pecas clivus:g1) "")
(command "CLIVUS_GRUPOS")
(command "CLIVUS_GRUPO_SELECIONAR" "Bloco A")
(command "CLIVUS_GRUPO_APAGAR" "bloco a")
(setq clivus:marcaApagada (clivus:marcas))
(command "CLIVUS_GRUPOS")
(princ (strcat "\nCLIVUS_GRUPOS_LISP mesas=" (itoa clivus:depois) " so2=" (itoa clivus:so2) " marca=" (itoa clivus:marcaCriada) " marcaApagada=" (itoa clivus:marcaApagada)
               " zhachura=" (rtos clivus:zh 2 3) " zmesas=" (rtos clivus:zm 2 3)))
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
