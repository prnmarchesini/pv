; Teste de nivel 2 do passo 4.4, segunda metade: abre o desenho que a
; primeira metade salvou e escreve a configuracao gravada, campo a campo.
;
; Tem que responder "CONFIG Gravada no desenho" e exatamente os mesmos
; CONFIG_CAMPO da primeira metade. "CONFIG Ausente" e a configuracao nao ter
; sobrevivido ao arquivo; "CONFIG Problema" e a leitura de volta nao entender
; o que ela mesma gravou.

(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_CONFIG_STATUS")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
