; Nivel 2 da vala que entra na area dos inversores (segunda rodada de 10/10/2026,
; item 6). Usina pelo motor e strings de teste como no caso da rota CC; o
; Inversor 1 posto numa area ao sul da usina pelo Local dos inversores e o
; Inversor 2 posto a mao dentro da mesma area (sem o registro dela, como os
; inversores 9 e 10 do desenho de Itatiba). Valas: a do leste (norte-sul), uma
; que sai dela e entra na area pelo sul, e outra que sai dela e para a 6 m ao
; norte da area (a 8 m do Inversor 2, dentro do raio de 10 m, e por ela o
; caminho e menor). O Gerar CC tem que levar todos os cabos pela vala que
; entra na area.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area rota area")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento rota area")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(command "CLIVUS_STRINGS_TESTE_AUTO")
(command "CLIVUS_ELETRICA_AUTO" "Uc" "Unitarias" "1")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "U1" "T1")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "2")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 1" "6")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 2" "6")
; ---- a area: o Inversor 1 pelo Local dos inversores, o 2 a mao dentro dela ----
(command "_.PLINE" "{{S1}}" "{{S2}}" "{{S3}}" "{{S4}}" "_C")
(setq clivus:sala (entlast))
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 1" clivus:sala "Sala rota")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 2" "{{I2}}")
; ---- as valas -------------------------------------------------------------
(command "_.PLINE" "{{V1}}" "{{V2}}" "")
(setq clivus:sel (ssadd (entlast)))
(command "_.PLINE" "{{V1}}" "{{SUL1}}" "{{SUL2}}" "")
(ssadd (entlast) clivus:sel)
(command "_.PLINE" "{{N1}}" "{{N2}}" "")
(ssadd (entlast) clivus:sel)
(command "CLIVUS_ROTA_VALA" "CC" clivus:sel "")
; ---- gerar e conferir ------------------------------------------------------
(princ "\nCLIVUS_ROTAAREA GERAR")
(command "CLIVUS_ROTA_GERAR" "CC")
(princ "\nCLIVUS_ROTAAREA CONFERIR")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
; ---- revisao da noite de 10/10/2026 ----------------------------------------
; (a) o automatico nunca dentro de uma area: o Inversor 3 (automatico) e posto
; pelo Gerar; uma sala de 8 x 8 m e desenhada em volta desse ponto (dos dois
; lados da vala) e recebe o Inversor 4; o 3 e tirado de la com o MOVE e o
; Recolocar o leva ao ponto seguinte da vala, fora da sala.
(defun clivus:etiqueta (bloco / e d txt)
  (setq e (tblobjname "BLOCK" bloco) txt "?")
  (while (setq e (entnext e))
    (setq d (entget e))
    (if (= (cdr (assoc 0 d)) "MTEXT") (setq txt (cdr (assoc 1 d)))))
  txt)
(defun clivus:inv (tag / ss i e achado)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_EQUIPAMENTO_*"))) i 0)
  (while (and ss (< i (sslength ss)) (not achado))
    (setq e (ssname ss i) i (1+ i))
    (if (= (clivus:etiqueta (cdr (assoc 2 (entget e)))) tag) (setq achado e)))
  achado)
(defun clivus:quadro (x y r)
  (command "_.PLINE" (list (- x r) (- y r)) (list (+ x r) (- y r)) (list (+ x r) (+ y r)) (list (- x r) (+ y r)) "_C")
  (entlast))
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "2")
(command "CLIVUS_ELETRICA_AUTO" "Alocar" "Inversor 3" "6")
(command "CLIVUS_ELETRICA_LOCAL" "Strings" "Inversor 3")
(princ "\nCLIVUS_ROTAAREA AUTO1")
(command "CLIVUS_ROTA_GERAR" "CC")
(setq clivus:p3 (cdr (assoc 10 (entget (clivus:inv "Inversor 3")))) clivus:x3 (car clivus:p3) clivus:y3 (cadr clivus:p3))
(princ (strcat "\nCLIVUS_ROTAAREA_SALA_AUTO minx=" (rtos (- clivus:x3 4) 2 3) " miny=" (rtos (- clivus:y3 4) 2 3)
               " maxx=" (rtos (+ clivus:x3 4) 2 3) " maxy=" (rtos (+ clivus:y3 4) 2 3) " fim"))
(setq clivus:salaauto (clivus:quadro clivus:x3 clivus:y3 4))
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 4" clivus:salaauto "Sala auto")
(command "_.MOVE" (clivus:inv "Inversor 3") "" "0,0" "-15,0")
(princ "\nCLIVUS_ROTAAREA AUTO2")
(command "CLIVUS_ROTA_RECOLOCAR" "CC")
(princ "\nCLIVUS_ROTAAREA AUTO_CONFERIR")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
; (b) area dentro de area: o Patio fora (20 x 20 m) envolve a Sala auto; o
; Inversor 4 escolhido para o Patio vai para fora da sala (que e menor) e e do Patio.
(princ "\nCLIVUS_ROTAAREA PATIO")
(setq clivus:patio (clivus:quadro clivus:x3 clivus:y3 10))
(command "CLIVUS_ELETRICA_LOCAL" "Area" "Inversor 4" clivus:patio "Patio fora")
(command "CLIVUS_ROTA_CONFERIR_AUTO")
(princ "\nCLIVUS_ROTAAREA REVISAO_FIM")
(setvar "OSMODE" clivus:osmode)
(princ "\nCLIVUS_ROTAAREA_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ)
