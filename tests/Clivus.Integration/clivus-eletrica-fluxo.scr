; Nivel 2 do fluxo eletrico inteiro, num desenho so, com as pecas de verdade
; (sem CLIVUS_STRINGS_TESTE_AUTO nem a cadeia de exemplo da numeracao).
; Usina mista pelo motor (mesas de 28 e de 14); dois tipos de string com
; tracado completo: "Par 28" (duas de 28 vizinhas, uma string por fileira que
; atravessa o vao) e Modelo 1 (uma de 28, uma string por fileira; o nome
; volta a ficar livre depois do Renomear). Nenhum tipo casa com a mesa de 14:
; ela tem que ser avisada pelo nome. Gerar em duas selecoes (uma mesa de 28
; sozinha, onde so o Modelo 1 cabe; depois todas as outras mesas);
; UC1 (compartilhada) e U1 (unitaria); T1 e T2; modelo Huawei 250 (5x4) e
; quatro inversores; as strings reais alocadas em quatro partes pelo comando
; de verdade (selecao montada no LISP), e depois todas de novo para o
; Inversor 4 (as dos outros ficam travadas); trafos e inversores em campo e o
; skid pela selecao dos retangulos; T1 na UC1 e T2 na U1; numeracao e resumo.
; No fim o LISP grava num arquivo o que esta no desenho (XData das strings,
; dos modulos e das mesas; registros do dicionario: inversores, trafos e
; subestacoes), com os watts de cada string somados aqui, pela mesa dona de
; cada modulo. Quem confere e o runner.
(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area fluxo eletrico")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento fluxo eletrico")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(setvar "OSMODE" clivus:osmode)
(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))
(defun clivus:mesa (rotulo / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (clivus:tipo xd) "Mesa") (= (clivus:campo xd 1) rotulo)) (setq achada e))
    (setq i (1+ i)))
  achada)
(defun clivus:junta (lista / ss) (setq ss (ssadd)) (foreach e lista (if e (ssadd e ss))) ss)
(defun clivus:perfil (rotulo) (clivus:campo (clivus:xdata (clivus:mesa rotulo)) 15))
(defun clivus:primeira (perfil / ss i e achada xd)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) i 0)
  (while (and ss (< i (sslength ss)) (not achada))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (clivus:tipo xd) "Mesa") (= (clivus:campo xd 15) perfil)) (setq achada e))
    (setq i (1+ i)))
  achada)
(defun clivus:par28 (/ f n a b par)
  (setq f 1)
  (while (and (< f 60) (not par))
    (setq n 1)
    (while (and (< n 30) (not par))
      (setq a (strcat "F" (itoa f) "." (itoa n)) b (strcat "F" (itoa f) "." (itoa (1+ n))))
      (if (and (clivus:mesa a) (clivus:mesa b) (= (clivus:perfil a) "Mesa 2V28") (= (clivus:perfil b) "Mesa 2V28"))
        (setq par (list (clivus:mesa a) (clivus:mesa b))))
      (setq n (1+ n)))
    (setq f (1+ f)))
  par)
; ---- strings reais: dois tipos com tracado completo, gerar em tudo ----------
(command "CLIVUS_STRING_MESAS" (clivus:junta (clivus:par28)) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 1" "FILEIRA:C:0.0.0;FILEIRA:C:0.0.1")
(command "CLIVUS_STRING_TIPO_AUTO" "Renomear" "Modelo 1" "Par 28")
(command "CLIVUS_STRING_MESAS" (clivus:junta (list (clivus:primeira "Mesa 2V28"))) "")
(command "CLIVUS_STRING_TRACADO_AUTO" "Modelo 1" "FILEIRA:C:0.0.0;FILEIRA:C:0.0.1")
(command "CLIVUS_STRING_TIPO_AUTO" "Listar")
(setq clivus:sozinha (clivus:primeira "Mesa 2V28"))
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) clivus:i 0 clivus:outras (ssadd))
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:e (ssname clivus:ss clivus:i) clivus:i (1+ clivus:i))
  (if (and (= (clivus:tipo (clivus:xdata clivus:e)) "Mesa") (not (eq clivus:e clivus:sozinha))) (ssadd clivus:e clivus:outras)))
(princ (strcat "\nCLIVUS_FLUXO_SOZINHA " (clivus:campo (clivus:xdata clivus:sozinha) 1) " outras=" (itoa (sslength clivus:outras))))
(princ "\nCLIVUS_FLUXO GERAR1")
(command "CLIVUS_STRING_GERAR" (clivus:junta (list clivus:sozinha)) "")
(princ "\nCLIVUS_FLUXO GERAR")
(command "CLIVUS_STRING_GERAR" clivus:outras "")
; ---- cadastro: subestacoes, trafos, modelo e inversores -------------------
(command "CLIVUS_ELETRICA_AUTO" "Uc" "Compartilhada")
(command "CLIVUS_ELETRICA_AUTO" "Uc" "Unitarias" "1")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Trafo" "2")
(command "CLIVUS_ELETRICA_AUTO" "Modelo" "Huawei 250" "5" "4")
(command "CLIVUS_ELETRICA_AUTO" "Inversores" "Huawei 250" "4")
; ---- alocacao: as strings reais em quatro partes, pela selecao -------------
(defun clivus:strings () (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "CLIVUS_STRING") (list -3 (list "CLIVUS")))))
(setq clivus:todas (clivus:strings) clivus:n (clivus:conta clivus:todas) clivus:parte (/ (+ clivus:n 3) 4) clivus:k 0)
(princ (strcat "\nCLIVUS_FLUXO_ALOCAR strings=" (itoa clivus:n) " parte=" (itoa clivus:parte)))
(princ "\nCLIVUS_FLUXO ALOCAR")
(foreach clivus:inv (list "Inversor 1" "Inversor 2" "Inversor 3" "Inversor 4")
  (setq clivus:sel (ssadd) clivus:i 0)
  (while (and (< clivus:i clivus:parte) (< clivus:k clivus:n))
    (ssadd (ssname clivus:todas clivus:k) clivus:sel)
    (setq clivus:i (1+ clivus:i) clivus:k (1+ clivus:k)))
  (if (> (sslength clivus:sel) 0) (command "CLIVUS_ELETRICA_ALOCAR" clivus:inv clivus:sel "")))
; Todas de novo para o Inversor 4: as dos outros inversores ficam travadas.
(princ "\nCLIVUS_FLUXO REALOCAR")
(command "CLIVUS_ELETRICA_ALOCAR" "Inversor 4" clivus:todas "")
; ---- em campo e o skid pela selecao dos retangulos -------------------------
(setvar "OSMODE" 0)
(command "CLIVUS_ELETRICA_POSICIONAR" "T1" "{{P1}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "T2" "{{P2}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 1" "{{Q1}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 2" "{{Q2}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 3" "{{Q3}}")
(command "CLIVUS_ELETRICA_POSICIONAR" "Inversor 4" "{{Q4}}")
(setvar "OSMODE" clivus:osmode)
(defun clivus:etiqueta (bloco / e d txt)
  (setq e (tblobjname "BLOCK" bloco) txt "?")
  (while (setq e (entnext e))
    (setq d (entget e))
    (if (= (cdr (assoc 0 d)) "MTEXT") (setq txt (cdr (assoc 1 d)))))
  txt)
(defun clivus:blocos (tags / ss i e r)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_EQUIPAMENTO_*"))) i 0 r (ssadd))
  (while (< i (clivus:conta ss))
    (setq e (ssname ss i) i (1+ i))
    (if (member (clivus:etiqueta (cdr (assoc 2 (entget e)))) tags) (ssadd e r)))
  r)
(princ "\nCLIVUS_FLUXO SKID")
(command "CLIVUS_ELETRICA_SKID" "T1" "Skid A" (clivus:blocos (list "Inversor 1" "Inversor 2")) "")
(command "CLIVUS_ELETRICA_SKID" "T2" "Skid B" (clivus:blocos (list "Inversor 3" "Inversor 4")) "")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "UC1" "T1")
(command "CLIVUS_ELETRICA_AUTO" "Vincular" "U1" "T2")
; ---- numeracao e resumo ----------------------------------------------------
(princ "\nCLIVUS_FLUXO NUMERACAO")
(command "CLIVUS_NUMERACAO_AUTO" "Gerar")
(princ "\nCLIVUS_FLUXO TAGS")
(command "CLIVUS_NUMERACAO_AUTO" "Strings")
(princ "\nCLIVUS_FLUXO RESUMO")
(command "CLIVUS_ELETRICA_RESUMO_AUTO")
(princ "\nCLIVUS_FLUXO DESENHO")
; ---- o que esta no desenho, lido pelo LISP --------------------------------
(defun clivus:sem-espaco (s) (if (= s "") "-" (vl-string-translate " " "_" s)))
(defun clivus:registro (chave / dic r)
  (setq dic (dictsearch (namedobjdict) "CLIVUS"))
  (if dic (setq r (dictsearch (cdr (assoc -1 dic)) chave)))
  (mapcar 'cdr (vl-remove-if-not '(lambda (p) (= (car p) 1)) r)))
; Os itens do registro (sem o cabecalho de quatro campos), n campos cada.
(defun clivus:itens (chave n / l r g)
  (setq l (cdr (cdr (cdr (cdr (clivus:registro chave))))))
  (while l
    (setq g nil)
    (repeat n (setq g (cons (car l) g) l (cdr l)))
    (setq r (cons (reverse g) r)))
  (reverse r))
(setq clivus:arq (open "{{DUMP}}" "w"))
(foreach i (clivus:itens "INVERSORES" (if (= (nth 1 (clivus:registro "INVERSORES")) "1") 4 5))
  (write-line (strcat "INV " (nth 0 i) " " (clivus:sem-espaco (nth 3 i)) " " (clivus:sem-espaco (nth 2 i))) clivus:arq))
(foreach clivus:tr (clivus:itens "TRAFOS" 13)
  (write-line (strcat "TRAFO " (nth 0 clivus:tr) " " (clivus:sem-espaco (nth 12 clivus:tr)) " " (clivus:sem-espaco (nth 2 clivus:tr))) clivus:arq))
; SUBESTACOES: 7 campos por UC no formato 1, 8 no 2 (o bloco fisico, 05/10/2026).
(foreach u (clivus:itens "SUBESTACOES" (if (= (nth 1 (clivus:registro "SUBESTACOES")) "1") 7 8))
  (write-line (strcat "UC " (nth 0 u) " " (clivus:sem-espaco (nth 1 u))) clivus:arq))
; Mesas (GUID, letreiro, perfil, watts) e a mesa dona de cada modulo.
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) clivus:i 0 clivus:mesas nil clivus:xds nil)
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:xd (clivus:xdata (ssname clivus:ss clivus:i)))
  (cond ((= (clivus:tipo clivus:xd) "Mesa")
         (setq clivus:mesas (cons (list (clivus:campo clivus:xd 0) (clivus:campo clivus:xd 1) (atof (clivus:campo clivus:xd 9))) clivus:mesas))
         (write-line (strcat "MESA " (clivus:campo clivus:xd 0) " " (clivus:campo clivus:xd 1) " " (clivus:sem-espaco (clivus:campo clivus:xd 15)) " " (clivus:campo clivus:xd 9)) clivus:arq))
        ((= (clivus:tipo clivus:xd) "String") (setq clivus:xds (cons clivus:xd clivus:xds))))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:ss (ssget "_X" (list (cons 0 "INSERT") (list -3 (list "CLIVUS")))) clivus:i 0 clivus:modulos nil)
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:xd (clivus:xdata (ssname clivus:ss clivus:i)))
  (if (= (clivus:tipo clivus:xd) "Modulo") (setq clivus:modulos (cons (cons (clivus:campo clivus:xd 0) (clivus:campo clivus:xd 1)) clivus:modulos)))
  (setq clivus:i (1+ clivus:i)))
(write-line (strcat "MODULOS " (itoa (length clivus:modulos))) clivus:arq)
; Cada string: GUID, tipo, inversor, tag, quantos modulos, watts (somados
; aqui pela mesa dona de cada modulo), as mesas (letreiros, sem repetir) e os
; modulos.
(foreach xd clivus:xds
  (setq clivus:n (atoi (clivus:campo xd 4)) clivus:k 0 clivus:watts 0.0 clivus:letreiros nil clivus:lista "")
  (while (< clivus:k clivus:n)
    (setq clivus:m (clivus:campo xd (+ 5 clivus:k))
          clivus:dona (assoc (cdr (assoc clivus:m clivus:modulos)) clivus:mesas))
    (setq clivus:lista (strcat clivus:lista " " clivus:m))
    (if clivus:dona
      (progn
        (setq clivus:watts (+ clivus:watts (caddr clivus:dona)))
        (if (not (member (cadr clivus:dona) clivus:letreiros)) (setq clivus:letreiros (append clivus:letreiros (list (cadr clivus:dona))))))
      (setq clivus:letreiros (append clivus:letreiros (list "?"))))
    (setq clivus:k (1+ clivus:k)))
  (write-line (strcat "S " (clivus:campo xd 0) " " (clivus:sem-espaco (clivus:campo xd 1)) " " (clivus:sem-espaco (clivus:campo xd 2))
                      " " (clivus:sem-espaco (clivus:campo xd 3)) " " (itoa clivus:n) " " (rtos clivus:watts 2 3)
                      " " (if clivus:letreiros (apply 'strcat (cons (car clivus:letreiros) (mapcar '(lambda (x) (strcat "," x)) (cdr clivus:letreiros)))) "-")
                      clivus:lista) clivus:arq))
(close clivus:arq)
(princ "\nCLIVUS_FLUXO_FIM")
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
