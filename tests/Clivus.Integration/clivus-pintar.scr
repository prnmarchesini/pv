; Teste de nivel 2 do Pintar estouros (27/09/2026): processa uma fileira,
; conta as pecas por tipo e soma os GUIDs das mesas; repinta
; (CLIVUS_PINTAR_AUTO) e conta de novo. Repintar nao move, nao duplica e nao
; troca identidade: mesmas mesas, mesmos GUIDs, mesmas pecas.

(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area do pintar")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento do pintar")
(command "CLIVUS_FILEIRA_AUTO")
(setvar "OSMODE" clivus:osmode)

(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun clivus:tipo (xd) (cdr (nth 0 xd)))

(defun clivus:contar (rotulo / tudo n i xd tp mesas pil mod fac)
  (setq tudo (ssget "_X" (list (cons -3 (list (list "CLIVUS"))))))
  (setq n (if tudo (sslength tudo) 0) i 0 mesas 0 pil 0 mod 0 fac 0 clivus:guids nil clivus:zs nil)
  (while (< i n)
    (setq xd (clivus:xdata (ssname tudo i)) tp (clivus:tipo xd))
    (cond ((= tp "Mesa")
           (setq mesas (1+ mesas) clivus:guids (cons (clivus:campo xd 0) clivus:guids))
           ; A cota dos dois cantos da borda baixa, lida da entidade.
           (setq clivus:v (entnext (ssname tudo i)))
           (setq clivus:zs (cons (list (clivus:campo xd 0) (cadddr (assoc 10 (entget clivus:v))) (cadddr (assoc 10 (entget (entnext clivus:v))))) clivus:zs)))
          ((= tp "Pilar") (setq pil (1+ pil)))
          ((= tp "Modulo") (setq mod (1+ mod)))
          ((= tp "Face") (setq fac (1+ fac))))
    (setq i (1+ i)))
  (princ (strcat "\nCLIVUS_PINTAR_LISP " rotulo " mesas=" (itoa mesas) " pilares=" (itoa pil) " modulos=" (itoa mod) " faces=" (itoa fac))))

(clivus:contar "antes")
(setq clivus:antes clivus:guids clivus:zsantes clivus:zs)
(command "CLIVUS_PINTAR_AUTO")
(clivus:contar "depois")
(setq clivus:mesmos 0 clivus:dz 0.0)
(foreach a clivus:zsantes
  (if (setq clivus:b (assoc (car a) clivus:zs))
    (setq clivus:dz (max clivus:dz (abs (- (cadr a) (cadr clivus:b))) (abs (- (caddr a) (caddr clivus:b)))))))
(princ (strcat "\nCLIVUS_PINTAR_COTAS dz=" (rtos clivus:dz 2 6)))
(foreach g clivus:antes (if (member g clivus:guids) (setq clivus:mesmos (1+ clivus:mesmos))))
; Os grupos anonimos (um por mesa): depois de repintar, os velhos sumiram
; (ficaram vazios e foram apagados) e ha um novo por mesa.
(setq clivus:grupos 0)
(foreach par (entget (cdr (assoc -1 (dictsearch (namedobjdict) "ACAD_GROUP"))))
  (if (and (= (car par) 3) (= (substr (cdr par) 1 2) "*A")) (setq clivus:grupos (1+ clivus:grupos))))
(princ (strcat "\nCLIVUS_PINTAR_GRUPOS " (itoa clivus:grupos)))
(princ (strcat "\nCLIVUS_PINTAR_GUIDS mesmos=" (itoa clivus:mesmos) " de=" (itoa (length clivus:antes))))
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
