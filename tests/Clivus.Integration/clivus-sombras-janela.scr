; Teste de nivel 2 das sombras pela JANELA (04/10/2026 e 42.1): o botao da
; janela roda fora de um comando, e o vigia tomava o que a sombra mexia por
; edicao do usuario (mesas pendentes, modulos vermelhos). Arvore FORA da
; fileira, ao norte da F1.3; o calculo pelo mesmo caminho do botao
; (clivus-sombras-pela-janela, so no build Debug); depois um REGEN (comando
; que nao e nosso) para o vigia agir. Exige: hachuras magenta de sombra no
; chao e sobre as mesas, nenhum modulo vermelho de pendente e nenhum modulo
; com a cor ou a camada mudada (a sombra nao pinta mais o bloco). Depois os
; botoes Ocultar e Mostrar, tambem fora de comando: a camada CLIVUS_SOMBRA
; desligada e ligada de novo (o 62 da camada negativo quando desligada).

(setq clivus:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "CLIVUS_TERRENO_AUTO")
(setq clivus:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "CLIVUS_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area sombras")
(command "CLIVUS_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento sombras")
(command "CLIVUS_MESAS_EXEMPLO_AUTO")
(command "CLIVUS_USINA_AUTO")
(defun clivus:conta (ss) (if ss (sslength ss) 0))
(defun clivus:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("CLIVUS")))))))
(defun clivus:verts (e / v l)
  (setq v (entnext e))
  (while (and v (= (cdr (assoc 0 (entget v))) "VERTEX"))
    (setq l (cons (cdr (assoc 10 (entget v))) l) v (entnext v)))
  l)
(setq clivus:ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "CLIVUS")))) clivus:i 0 clivus:meio nil)
(while (< clivus:i (clivus:conta clivus:ss))
  (setq clivus:e (ssname clivus:ss clivus:i) clivus:xd (clivus:xdata clivus:e))
  (if (and (= (cdr (nth 0 clivus:xd)) "Mesa") (= (cdr (nth 3 clivus:xd)) "F1.3"))
    (setq clivus:v (clivus:verts clivus:e)))
  (setq clivus:i (1+ clivus:i)))
(setq clivus:meio (list (/ (apply '+ (mapcar 'car clivus:v)) 4.0) (/ (apply '+ (mapcar 'cadr clivus:v)) 4.0) 0.0))
(setq clivus:a (mapcar '- (nth 1 clivus:v) (nth 0 clivus:v)) clivus:b (mapcar '- (nth 2 clivus:v) (nth 1 clivus:v)))
(defun clivus:len (u) (sqrt (+ (* (car u) (car u)) (* (cadr u) (cadr u)))))
(setq clivus:curto (if (< (clivus:len clivus:a) (clivus:len clivus:b)) clivus:a clivus:b))
(setq clivus:w (clivus:len clivus:curto) clivus:k (* 1 (/ (+ (/ clivus:w 2.0) 3.0) clivus:w)))
(setq clivus:pe (list (+ (car clivus:meio) (* clivus:k (car clivus:curto))) (+ (cadr clivus:meio) (* clivus:k (cadr clivus:curto))) 0.0))
(command "CLIVUS_ARVORE_AUTO" 4 0.6 10 8 clivus:pe "")
(setvar "OSMODE" clivus:osmode)

(defun clivus:cor (c / ss i n)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_MOD*"))) i 0 n 0)
  (while (< i (clivus:conta ss))
    (if (member (cdr (assoc 420 (entget (ssname ss i)))) c) (setq n (1+ n)))
    (setq i (1+ i)))
  n)
(defun clivus:assinatura ( / ss i l)
  (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 "CLIVUS_MOD*"))) i 0)
  (while (< i (clivus:conta ss))
    (setq l (cons (list (cdr (assoc 5 (entget (ssname ss i)))) (cdr (assoc 62 (entget (ssname ss i)))) (cdr (assoc 420 (entget (ssname ss i)))) (cdr (assoc 8 (entget (ssname ss i))))) l) i (1+ i)))
  l)
; As hachuras magenta de sombra de um lugar ("Chao" ou "Mesa").
(defun clivus:hachuras (onde / ss i e xd n)
  (setq ss (ssget "_X" (list (cons 0 "HATCH") (list -3 (list "CLIVUS")))) i 0 n 0)
  (while (< i (clivus:conta ss))
    (setq e (ssname ss i) xd (clivus:xdata e))
    (if (and (= (cdr (nth 0 xd)) "Sombra") (= (cdr (nth 3 xd)) onde) (= (cdr (assoc 420 (entget e))) 16711935)) (setq n (1+ n)))
    (setq i (1+ i)))
  n)
(defun clivus:desligada (nome) (minusp (cdr (assoc 62 (tblsearch "LAYER" nome)))))

(setq clivus:antes (clivus:assinatura))
(princ "\nCLIVUS_JANELA_ANTES")
(clivus-sombras-pela-janela "21/06/2026" "12:00" "-3")
(command "_.REGEN")
(setq clivus:igual (if (equal clivus:antes (clivus:assinatura)) "1" "0"))

(clivus-sombras-acao "ocultar")
(setq clivus:oculta (if (clivus:desligada "CLIVUS_SOMBRA") "1" "0"))
(clivus-sombras-acao "mostrar")
(setq clivus:mostra (if (clivus:desligada "CLIVUS_SOMBRA") "0" "1"))

(princ (strcat "\nCLIVUS_JANELA chao=" (itoa (clivus:hachuras "Chao"))
               " mesa=" (itoa (clivus:hachuras "Mesa"))
               " modulos=" (itoa (length (clivus-sombras-modulos)))
               " vermelhos=" (itoa (clivus:cor '(16711680)))
               " igual=" clivus:igual " oculta=" clivus:oculta " mostra=" clivus:mostra " fim"))
(setvar "SECURELOAD" clivus:secureload)
(princ (strcat "\nCLIVUS_SECURELOAD_ANTES=" (itoa clivus:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
