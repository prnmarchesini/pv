; Teste de nivel 2 do 7.10: processa a usina inteira (80 mesas em 16
; fileiras), guarda o letreiro de cada GUID, e numera de novo com a F1.1
; na antiga F16.5 e a ultima fileira na antiga F1.1 (pela opcao Letreiro).
; Toda mesa F(r).(n) tem que virar F(17-r).(6-n); o aviso NAO CABE, se
; houver, tem que comecar pelo letreiro novo. Numerar de novo com os
; letreiros novos nao troca nada.
(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area da numeracao")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento da numeracao")
(command "UFV_USINA_AUTO")
(setvar "OSMODE" ufv:osmode)
(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))
(defun ufv:contornos ( / tudo n i ss en)
  (setq tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))) ss (ssadd) i 0 n (if tudo (sslength tudo) 0))
  (while (< i n)
    (setq en (ssname tudo i))
    (if (= (ufv:tipo (ufv:xdata en)) "Mesa") (ssadd en ss))
    (setq i (1+ i)))
  ss)
; ANTES: (guid . letreiro) de cada contorno, e os outros campos do XData
; (cota, giro, marcada, suja...) para conferir que so o letreiro muda.
(defun ufv:resto (xd / i r) (setq i 2 r "") (while (< i 13) (setq r (strcat r "|" (ufv:campo xd i)) i (1+ i))) r)
(setq ufv:cs (ufv:contornos) ufv:antes nil ufv:restos nil ufv:i 0)
(while (< ufv:i (sslength ufv:cs))
  (setq ufv:xd (ufv:xdata (ssname ufv:cs ufv:i)))
  (setq ufv:antes (cons (cons (ufv:campo ufv:xd 0) (ufv:campo ufv:xd 1)) ufv:antes))
  (setq ufv:restos (cons (cons (ufv:campo ufv:xd 0) (ufv:resto ufv:xd)) ufv:restos))
  (if (= (ufv:campo ufv:xd 1) "F16.5") (setq ufv:g165 (ufv:campo ufv:xd 0)))
  (setq ufv:i (1+ ufv:i)))
; Planta um aviso NAO CABE na F16.5, com a identidade de nota do plugin
; (tipo "Nota", versao 1, GUID da nota, GUID da mesa), para provar que o
; letreiro do aviso e trocado junto.
(entmake (list '(0 . "MTEXT") '(100 . "AcDbEntity") '(8 . "MARCHENG_UFV_MARCADA") '(100 . "AcDbMText")
               '(10 0.0 0.0 0.0) '(40 . 0.5) '(1 . "F16.5 NAO CABE NO TERRENO\\Pplantado pelo teste")
               (list -3 (list "MARCHENG_UFV" '(1000 . "Nota") '(1070 . 1) '(1000 . "0f0f0f0f-0f0f-4f0f-8f0f-0f0f0f0f0f0f") (cons 1000 ufv:g165)))))
(command "UFV_NUMERAR" "Letreiro" "F16.5" "Letreiro" "F1.1")
; DEPOIS: F(r).(n) virou F(17-r).(6-n)?
(defun ufv:fileira (l) (atoi (substr l 2 (- (vl-string-search "." l) 1))))
(defun ufv:numero (l) (atoi (substr l (+ 2 (vl-string-search "." l)))))
(defun ufv:esperado (l) (strcat "F" (itoa (- 17 (ufv:fileira l))) "." (itoa (- 6 (ufv:numero l)))))
(setq ufv:cs (ufv:contornos) ufv:ok 0 ufv:intactas 0 ufv:letreiros nil ufv:i 0)
(while (< ufv:i (sslength ufv:cs))
  (setq ufv:xd (ufv:xdata (ssname ufv:cs ufv:i)))
  (setq ufv:novo (ufv:campo ufv:xd 1) ufv:velho (cdr (assoc (ufv:campo ufv:xd 0) ufv:antes)))
  (if (= ufv:novo (ufv:esperado ufv:velho)) (setq ufv:ok (1+ ufv:ok)))
  (if (= (ufv:resto ufv:xd) (cdr (assoc (ufv:campo ufv:xd 0) ufv:restos))) (setq ufv:intactas (1+ ufv:intactas)))
  (if (not (member ufv:novo ufv:letreiros)) (setq ufv:letreiros (cons ufv:novo ufv:letreiros)))
  (setq ufv:i (1+ ufv:i)))
; Os avisos NAO CABE: o texto comeca pelo letreiro da mesa dona.
(setq ufv:notas (ssget "_X" (list (cons 0 "MTEXT") (cons -3 (list (list "MARCHENG_UFV"))))) ufv:ruins 0 ufv:cabe 0 ufv:i 0)
(setq ufv:n (if ufv:notas (sslength ufv:notas) 0))
(while (< ufv:i ufv:n)
  (setq ufv:en (ssname ufv:notas ufv:i) ufv:txt (cdr (assoc 1 (entget ufv:en))))
  (if (vl-string-search "CABE" ufv:txt)
    (progn
      (setq ufv:cabe (1+ ufv:cabe))
      (setq ufv:dona (ufv:campo (ufv:xdata ufv:en) 1) ufv:j 0 ufv:let nil)
      (while (< ufv:j (sslength ufv:cs))
        (setq ufv:xd (ufv:xdata (ssname ufv:cs ufv:j)))
        (if (= (ufv:campo ufv:xd 0) ufv:dona) (setq ufv:let (ufv:campo ufv:xd 1)))
        (setq ufv:j (1+ ufv:j)))
      (if (or (null ufv:let) (/= (vl-string-search (strcat ufv:let " ") ufv:txt) 0)) (setq ufv:ruins (1+ ufv:ruins)))))
  (setq ufv:i (1+ ufv:i)))
(command "UFV_NUMERAR" "Letreiro" "F1.1" "Letreiro" "F16.1")
(princ (strcat "\nUFV_NUMERAR_LISP invertidas=" (itoa ufv:ok) " de " (itoa (sslength ufv:cs)) " letreiros=" (itoa (length ufv:letreiros)) " avisos=" (itoa ufv:ruins) " de " (itoa ufv:cabe) " intactas=" (itoa ufv:intactas)))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
