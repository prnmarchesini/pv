; Teste de nivel 2 das alturas como analise (26/09/2026): processa uma
; fileira, conta as entidades da camada das alturas, apaga TODAS elas pelo
; AutoCAD (como o usuario faria) e planta um texto orfao sem identidade na
; camada; UFV_ALTURAS_REGERAR apaga o orfao e redesenha o mesmo numero de
; cotas, todas com identidade de nota e com o texto legivel (rumo em
; (-90, 90]).
(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area das alturas")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento das alturas")
(command "UFV_FILEIRA_AUTO")
; Desde o 8.8 gerar nao poe cota: as alturas vem do comando de analise.
(command "UFV_ALTURAS_REGERAR")
(setvar "OSMODE" ufv:osmode)
(defun ufv:camada ( / ss) (setq ss (ssget "_X" (list (cons 8 "MARCHENG_UFV_ALTURAS")))) (if ss (sslength ss) 0))
(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(setq ufv:antes (ufv:camada))
; A camada esta desligada: liga para o ERASE por selecao pegar.
(command "_.-LAYER" "_ON" "MARCHENG_UFV_ALTURAS" "")
(command "_.ERASE" (ssget "_X" (list (cons 8 "MARCHENG_UFV_ALTURAS"))) "")
(setq ufv:zerado (ufv:camada))
(entmake (list '(0 . "MTEXT") '(100 . "AcDbEntity") '(8 . "MARCHENG_UFV_ALTURAS") '(100 . "AcDbMText") '(10 0.0 0.0 0.0) '(40 . 0.35) '(1 . "PB 9,99 orfao")))
(setq ufv:comOrfao (ufv:camada))
(command "UFV_ALTURAS_REGERAR")
(setq ufv:depois (ufv:camada) ufv:semId 0 ufv:viradas 0 ufv:i 0)
(setq ufv:ss (ssget "_X" (list (cons 8 "MARCHENG_UFV_ALTURAS"))))
(while (< ufv:i ufv:depois)
  (setq ufv:en (ssname ufv:ss ufv:i) ufv:ed (entget ufv:en '("MARCHENG_UFV")))
  (if (null (assoc -3 ufv:ed)) (setq ufv:semId (1+ ufv:semId)))
  (if (= (cdr (assoc 0 ufv:ed)) "MTEXT")
    (progn (setq ufv:rot (cdr (assoc 50 ufv:ed)))
           (if (or (> ufv:rot (+ (/ pi 2) 1e-6)) (<= ufv:rot (- (- (/ pi 2)) 1e-6))) (setq ufv:viradas (1+ ufv:viradas)))))
  (setq ufv:i (1+ ufv:i)))
(princ (strcat "\nUFV_ALTURAS_LISP antes=" (itoa ufv:antes) " zerado=" (itoa ufv:zerado) " comOrfao=" (itoa ufv:comOrfao) " depois=" (itoa ufv:depois) " semId=" (itoa ufv:semId) " viradas=" (itoa ufv:viradas)))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
