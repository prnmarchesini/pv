; Teste de nivel 2 das tags (passo 8.14): gera uma fileira e insere as
; tags de fileira, mesa, modulo e string (14 por string), conta em LISP pelo
; XData, com a cota na faixa do terreno (regra 5); strings de 20 deixam uma
; incompleta por mesa; apagar os modulos nao mexe nas outras.

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area das tags")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento das tags")
(command "UFV_FILEIRA_AUTO")
(setvar "OSMODE" ufv:osmode)

(defun ufv:conta (ss) (if ss (sslength ss) 0))
(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))

(setq ufv:zmin 1e99 ufv:zmax -1e99)
(defun ufv:tags (tipo / ss i e xd n z)
  (setq ss (ssget "_X" (list (cons 0 "MTEXT") (list -3 (list "MARCHENG_UFV")))) i 0 n 0)
  (while (< i (ufv:conta ss))
    (setq e (ssname ss i) xd (ufv:xdata e))
    (if (and (= (ufv:tipo xd) "Tag") (= (ufv:campo xd 2) tipo))
      (progn
        (setq n (1+ n) z (cadddr (assoc 10 (entget e))))
        (setq ufv:zmin (min ufv:zmin z) ufv:zmax (max ufv:zmax z))))
    (setq i (1+ i)))
  n)
(defun ufv:incompletas ( / ss i e xd n)
  (setq ss (ssget "_X" (list (cons 0 "MTEXT") (list -3 (list "MARCHENG_UFV")))) i 0 n 0)
  (while (< i (ufv:conta ss))
    (setq e (ssname ss i) xd (ufv:xdata e))
    (if (and (= (ufv:tipo xd) "Tag") (= (ufv:campo xd 2) "String") (wcmatch (ufv:campo xd 3) "*`*")) (setq n (1+ n)))
    (setq i (1+ i)))
  n)

(setq ufv:mesas (ufv:conta (ssget "_X" (list (cons 0 "POLYLINE") (cons 8 "MARCHENG_UFV_MESA,MARCHENG_UFV_MARCADA")))))
(setq ufv:modulos (ufv:conta (ssget "_X" (list (cons 0 "INSERT") (cons 2 "MARCHENG_UFV_MOD*")))))

; A tag de fileira pede a primeira e a ultima fileira (pelo letreiro) e o
; lado onde as tags vao (02/10/2026).
(command "UFV_TAG_FILEIRAS" "Letreiro" "F1.1" "Letreiro" "F1.2" "{{L1}}")
(command "UFV_TAG_MESAS")
(command "UFV_TAG_MESAS")
(command "UFV_TAG_MODULOS")
(command "UFV_TAG_STRINGS" 14)
(setq ufv:f (ufv:tags "Row") ufv:m (ufv:tags "Table") ufv:mo (ufv:tags "Module") ufv:s14 (ufv:tags "String") ufv:inc14 (ufv:incompletas))
(command "UFV_TAG_STRINGS" 20)
(setq ufv:s20 (ufv:tags "String") ufv:inc20 (ufv:incompletas))
(command "UFV_TAG_MODULOS_APAGAR")
(setq ufv:mofim (ufv:tags "Module") ufv:mfim (ufv:tags "Table"))

(princ (strcat "\nUFV_TAGS mesas=" (itoa ufv:mesas) " modulos=" (itoa ufv:modulos)
               " fileiras=" (itoa ufv:f) " tmesas=" (itoa ufv:m) " tmodulos=" (itoa ufv:mo)
               " s14=" (itoa ufv:s14) " inc14=" (itoa ufv:inc14) " s20=" (itoa ufv:s20) " inc20=" (itoa ufv:inc20)
               " modfim=" (itoa ufv:mofim) " mesasfim=" (itoa ufv:mfim)
               " zmin=" (rtos ufv:zmin 2 3) " zmax=" (rtos ufv:zmax 2 3)))
(setvar "SECURELOAD" ufv:secureload)
(princ)
