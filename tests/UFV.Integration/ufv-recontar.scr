; Teste de nivel 2 do 7.6: processa uma fileira, apaga o contorno de uma
; mesa com o ERASE (o vigia registra a remocao) e manda recontar. Confere:
;   - e apaga OUTRA mesa inteira (todas as pecas): o RECONTAR conta duas
;     mesas a menos, uma orfa, 28 modulos e 7 pilares a menos;
;   - lista a removida e limpa o registro: o UFV_ESTADO depois diz 0.
(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area do recontar")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento do recontar")
(command "UFV_FILEIRA_AUTO")
(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))
(defun ufv:conta-tipo (tp / ss n i c)
  (setq ss (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))) n (if ss (sslength ss) 0) i 0 c 0)
  (while (< i n) (if (= (ufv:tipo (ufv:xdata (ssname ss i))) tp) (setq c (1+ c))) (setq i (1+ i)))
  c)
(setq ufv:tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))))
(setq ufv:n (if ufv:tudo (sslength ufv:tudo) 0))
(setq ufv:eb nil ufv:i 0)
(while (and (< ufv:i ufv:n) (not ufv:eb))
  (setq ufv:en (ssname ufv:tudo ufv:i))
  (if (= (ufv:tipo (ufv:xdata ufv:en)) "Mesa") (setq ufv:eb ufv:en))
  (setq ufv:i (1+ ufv:i)))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun ufv:mesa (xd) (cond ((= (ufv:tipo xd) "Mesa") (ufv:campo xd 0)) ((= (ufv:tipo xd) "Face") (ufv:campo xd 2)) (T (ufv:campo xd 1))))
(setq ufv:antes (ufv:conta-tipo "Mesa") ufv:modantes (ufv:conta-tipo "Modulo") ufv:pilantes (ufv:conta-tipo "Pilar"))
; A mesa C: o segundo contorno, e todas as pecas dela.
(setq ufv:gc nil ufv:i 0 ufv:vistos 0)
(while (and (< ufv:i ufv:n) (not ufv:gc))
  (setq ufv:xd (ufv:xdata (ssname ufv:tudo ufv:i)))
  (if (= (ufv:tipo ufv:xd) "Mesa") (progn (setq ufv:vistos (1+ ufv:vistos)) (if (= ufv:vistos 2) (setq ufv:gc (ufv:campo ufv:xd 0)))))
  (setq ufv:i (1+ ufv:i)))
(setq ufv:ssc (ssadd) ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:en (ssname ufv:tudo ufv:i))
  (if (= (ufv:mesa (ufv:xdata ufv:en)) ufv:gc) (ssadd ufv:en ufv:ssc))
  (setq ufv:i (1+ ufv:i)))
(setq ufv:ssb (ssadd ufv:eb))
(command "_.ERASE" ufv:ssb "")
(command "_.ERASE" ufv:ssc "")
(setvar "OSMODE" ufv:osmode)
(command "UFV_RECONTAR")
(command "UFV_ESTADO")
(princ (strcat "\nUFV_RECONTAR_LISP antes=" (itoa ufv:antes) " modantes=" (itoa ufv:modantes) " pilantes=" (itoa ufv:pilantes)
               " mesas=" (itoa (ufv:conta-tipo "Mesa")) " modulos=" (itoa (ufv:conta-tipo "Modulo")) " pilares=" (itoa (ufv:conta-tipo "Pilar"))))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
