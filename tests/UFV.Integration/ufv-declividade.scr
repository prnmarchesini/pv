; Teste de nivel 2 da analise de declividade (29/09/2026): processa uma
; fileira e liga a declividade em graus, depois em porcentagem. Le do
; desenho, pelo XData:
;   - um texto de declividade por mesa, com o GUID dela, e o valor bate com
;     o contorno (desnivel da linha do meio sobre a distancia em planta):
;     em graus, o angulo; em porcentagem, a razao vezes cem;
;   - trocar a unidade nao deixa texto em dobro;
;   - a mesa recalculada nasce com a seta (o desenho da mesa consulta a
;     analise ligada);
;   - nada da camada fica fora da cota das mesas (regra sagrada 5);
;   - Desligar apaga tudo da camada.

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area da declividade")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento da declividade")
(command "UFV_FILEIRA_AUTO")
(setvar "OSMODE" ufv:osmode)

(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))
(defun ufv:verts (e / v l)
  (setq v (entnext e) l nil)
  (while (and v (= (cdr (assoc 0 (entget v))) "VERTEX"))
    (setq l (cons (cdr (assoc 10 (entget v))) l) v (entnext v)))
  (reverse l))
(defun ufv:meio (a b) (mapcar '(lambda (x y) (/ (+ x y) 2.0)) a b))
; O numero do texto: virgula vira ponto, e atof para no simbolo.
(defun ufv:num (s / i c r)
  (setq i 1 r "")
  (while (<= i (strlen s))
    (setq c (substr s i 1) r (strcat r (if (= c ",") "." c)) i (1+ i)))
  (atof r))

; A tangente da declividade de cada mesa, pelo contorno: (guid . tangente).
(defun ufv:tangentes ( / ss i e xd v p0 p1 plano l zmin zmax)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (cons -3 (list (list "MARCHENG_UFV"))))) i 0 l nil)
  (setq ufv:zmin 1e99 ufv:zmax -1e99)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) xd (ufv:xdata e))
    (if (= (ufv:tipo xd) "Mesa")
      (progn
        (setq v (ufv:verts e) p0 (ufv:meio (nth 0 v) (nth 3 v)) p1 (ufv:meio (nth 1 v) (nth 2 v))
              plano (distance (list (car p0) (cadr p0)) (list (car p1) (cadr p1))))
        (foreach q v (setq ufv:zmin (min ufv:zmin (caddr q)) ufv:zmax (max ufv:zmax (caddr q))))
        (setq l (cons (cons (ufv:campo xd 0) (/ (abs (- (caddr p1) (caddr p0))) plano)) l))))
    (setq i (1+ i)))
  l)

; Conta os textos da camada, os que batem com a mesa dona na unidade dada
; ("G" graus, "P" porcentagem), e o que sai da faixa de cota das mesas.
(defun ufv:conferir (unidade / tang ss i e d xd g t0 esperado n ok fora z tot)
  (setq tang (ufv:tangentes) n 0 ok 0 fora 0 i 0 tot 0)
  (setq ss (ssget "_X" (list (cons 8 "MARCHENG_UFV_SETA_DECLIVIDADE"))))
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) d (entget e) tot (1+ tot))
    ; No MTEXT o 11 e a direcao do texto, nao um ponto: so a linha tem 11.
    (foreach k (if (= (cdr (assoc 0 d)) "LINE") '(10 11) '(10))
      (if (assoc k d)
        (progn (setq z (caddr (cdr (assoc k d))))
               (if (or (< z (- ufv:zmin 0.2)) (> z (+ ufv:zmax 0.6))) (setq fora (1+ fora))))))
    (if (= (cdr (assoc 0 d)) "MTEXT")
      (progn
        (setq n (1+ n) xd (ufv:xdata e) g (if xd (ufv:campo xd 1)) t0 (cdr (assoc g tang)))
        (if t0
          (progn
            (setq esperado (if (= unidade "G") (* (atan t0) (/ 180.0 pi)) (* t0 100.0)))
            (if (< (abs (- esperado (ufv:num (cdr (assoc 1 d))))) 0.051) (setq ok (1+ ok)))))))
    (setq i (1+ i)))
  (list n ok fora (length tang) tot))

(command "UFV_DECLIVIDADE" "Graus")
(setq ufv:g (ufv:conferir "G"))
(command "UFV_DECLIVIDADE" "Porcentagem")
(setq ufv:p (ufv:conferir "P"))
(command "UFV_SUJAR_AUTO")
(command "UFV_RECALCULAR_AUTO")
(setq ufv:r (ufv:conferir "P"))
(command "UFV_DECLIVIDADE" "Desligar")
(setq ufv:d (ufv:conferir "P"))

(princ (strcat "\nUFV_DECLIV contornos=" (itoa (nth 3 ufv:g))
               " graus=" (itoa (nth 0 ufv:g)) " okg=" (itoa (nth 1 ufv:g))
               " porc=" (itoa (nth 0 ufv:p)) " okp=" (itoa (nth 1 ufv:p))
               " recalc=" (itoa (nth 0 ufv:r)) " okr=" (itoa (nth 1 ufv:r))
               " desligado=" (itoa (nth 4 ufv:d))
               " fora=" (itoa (+ (nth 2 ufv:g) (nth 2 ufv:p) (nth 2 ufv:r)))))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
