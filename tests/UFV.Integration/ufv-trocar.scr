; Teste de nivel 2 de trocar mesa (9.2) e regerar fileira (9.3): usina mista
; (28 e 14 em uso), a F1.2 trocada por duas de 14 travando o inicio; depois a
; fileira 1 reespacada mantendo as mesas, e a fileira 2 regerada pelo motor.
; Em LISP: letreiros e perfis pelo XData do contorno (campo 1 = letreiro,
; campo 15 = perfil), o menor vao em planta entre mesas vizinhas da fileira 1
; (antes, depois da troca e depois de reespacar) e a cota dos contornos
; novos (regra 5).

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area troca")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento troca")
(command "UFV_MESAS_EXEMPLO_AUTO")
(command "UFV_USINA_AUTO")
(setvar "OSMODE" ufv:osmode)

(defun ufv:conta (ss) (if ss (sslength ss) 0))
(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))

(defun ufv:verts (e / v l)
  (setq v (entnext e))
  (while (and v (= (cdr (assoc 0 (entget v))) "VERTEX"))
    (setq l (cons (cdr (assoc 10 (entget v))) l) v (entnext v)))
  (reverse l))

; (letreiro perfil ename) de cada contorno de mesa.
(defun ufv:mesas ( / ss i e xd l)
  (setq ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "MARCHENG_UFV")))) i 0)
  (while (< i (ufv:conta ss))
    (setq e (ssname ss i) xd (ufv:xdata e))
    (if (= (cdr (nth 0 xd)) "Mesa") (setq l (cons (list (ufv:campo xd 1) (ufv:campo xd 15) e) l)))
    (setq i (1+ i)))
  l)

(defun ufv:da (padrao / n) (setq n 0) (foreach m (ufv:mesas) (if (wcmatch (car m) padrao) (setq n (1+ n)))) n)
(defun ufv:perfil (letreiro / r) (foreach m (ufv:mesas) (if (= (car m) letreiro) (setq r (cadr m)))) (if r r "-"))
(defun ufv:ename (letreiro / r) (foreach m (ufv:mesas) (if (= (car m) letreiro) (setq r (caddr m)))) r)

; O menor vao em planta entre mesas vizinhas da fileira (padrao), ao longo da
; direcao da borda baixa da primeira mesa.
(defun ufv:menorvao (padrao / ms v0 v1 dx dy n faixas s lst menor)
  (setq ms (vl-remove-if-not '(lambda (m) (wcmatch (car m) padrao)) (ufv:mesas)))
  (setq v0 (car (ufv:verts (caddr (car ms)))) v1 (cadr (ufv:verts (caddr (car ms)))))
  (setq dx (- (car v1) (car v0)) dy (- (cadr v1) (cadr v0)) n (sqrt (+ (* dx dx) (* dy dy))) dx (/ dx n) dy (/ dy n))
  (foreach m ms
    (setq s (mapcar '(lambda (p) (+ (* (- (car p) (car v0)) dx) (* (- (cadr p) (cadr v0)) dy))) (ufv:verts (caddr m))))
    (setq faixas (cons (list (apply 'min s) (apply 'max s)) faixas)))
  (setq lst (vl-sort faixas '(lambda (a b) (< (car a) (car b)))) menor 1e99)
  (while (cdr lst)
    (setq menor (min menor (- (car (cadr lst)) (cadr (car lst)))) lst (cdr lst)))
  menor)

(setq ufv:total0 (length (ufv:mesas)) ufv:f1antes (ufv:da "F1`.*") ufv:perfil12 (ufv:perfil "F1.2") ufv:vao0 (ufv:menorvao "F1`.*"))

(command "UFV_TROCAR_MESA_AUTO" "F1.2" 2 2 "Inicio" "Nao")
(setq ufv:total1 (length (ufv:mesas)) ufv:f1troca (ufv:da "F1`.*")
      ufv:p2a (ufv:perfil "F1.2a") ufv:p2b (ufv:perfil "F1.2b") ufv:sem12 (ufv:perfil "F1.2")
      ufv:vaotroca (ufv:menorvao "F1`.*"))

; A cota do contorno novo: no terreno (regra 5), nunca 0.
(setq ufv:zmin 1e99 ufv:zmax -1e99)
(foreach p (ufv:verts (ufv:ename "F1.2a")) (setq ufv:zmin (min ufv:zmin (caddr p)) ufv:zmax (max ufv:zmax (caddr p))))

(command "UFV_REGERAR_FILEIRA_AUTO" "F1.1" "Manter")
(setq ufv:f1manter (ufv:da "F1`.*") ufv:vaomanter (ufv:menorvao "F1`.*") ufv:p2amanter (ufv:perfil "F1.2a"))

(setq ufv:f2antes (ufv:da "F2`.*"))
(command "UFV_REGERAR_FILEIRA_AUTO" "F2.1" "Motor")
(setq ufv:f2motor (ufv:da "F2`.*") ufv:total2 (length (ufv:mesas)))

(princ (strcat "\nUFV_TROCAR total0=" (itoa ufv:total0) " total1=" (itoa ufv:total1) " total2=" (itoa ufv:total2)
               " f1antes=" (itoa ufv:f1antes) " f1troca=" (itoa ufv:f1troca) " f1manter=" (itoa ufv:f1manter)
               " f2antes=" (itoa ufv:f2antes) " f2motor=" (itoa ufv:f2motor)
               " perfil12=" ufv:perfil12 " p2a=" ufv:p2a " p2b=" ufv:p2b " sem12=" ufv:sem12 " p2amanter=" ufv:p2amanter
               " vao0=" (rtos ufv:vao0 2 3) " vaotroca=" (rtos ufv:vaotroca 2 3) " vaomanter=" (rtos ufv:vaomanter 2 3)
               " zmin=" (rtos ufv:zmin 2 3) " zmax=" (rtos ufv:zmax 2 3)))
(setvar "SECURELOAD" ufv:secureload)
(princ)
