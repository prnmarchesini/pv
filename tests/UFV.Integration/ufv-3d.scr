; Teste de nivel 2 do 3D no navegador (9.9): uma fileira, uma arvore e a
; sombra das 09:00 de 21/06/2026; a pagina e gravada (sem abrir o navegador)
; em {{HTML}}. O runner le o arquivo: um so, sem nada de fora, com tantas
; faces quantas 3DFACE o desenho tem, a arvore, as sombras e o terreno.

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area 3D")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento 3D")
(command "UFV_FILEIRA_AUTO")
(command "UFV_ARVORE_AUTO" 4 0.6 10 8 "{{P}}" "")
(setvar "OSMODE" ufv:osmode)
(command "UFV_SOMBRAS_AUTO" "21/06/2026" "21/06/2026" "09:00" "09:00" "30" "-3" "1")
(command "UFV_3D_AUTO" "{{HTML}}")

(defun ufv:conta (ss) (if ss (sslength ss) 0))
(princ (strcat "\nUFV_3D faces=" (itoa (ufv:conta (ssget "_X" (list (cons 0 "3DFACE") (cons 8 "MARCHENG_UFV_FACE")))))
               " pilares=" (itoa (ufv:conta (ssget "_X" (list (cons 0 "INSERT") (cons 2 "MARCHENG_UFV_PILAR")))))))
(setvar "SECURELOAD" ufv:secureload)
(princ)
