; Teste de nivel 2 do passo 4.2: processa o terreno, traca um alinhamento de
; tres pontos com cotas de clique ERRADAS de proposito, e le do proprio
; desenho a cota de cada vertice da polilinha.
;
; Por que cotas erradas: em 25/09/2026 o Renan tracou o alinhamento em
; planta, com OSNAP, e um clique pegou a cota de uma curva de nivel enquanto
; o outro caiu em Z = 0. O comando guardou os dois como vieram, e a linha
; virou um poste de 700 m atravessando o terreno. Aqui o primeiro ponto entra
; com Z = 0 e o segundo com Z = 9999: se qualquer um deles sobreviver, o teste
; acusa.
;
; A leitura das pontas e feita em LISP direto na entidade (entlast), e nao
; pelo relatorio do plugin: um numero tirado do plugin concorda com o plugin
; mesmo quando ele erra.
;
; O OSNAP e desligado durante o comando. Com ele ligado, o Core Console
; puxa ate ponto digitado para o vertice de curva de nivel mais proximo, com a
; cota dele: o teste passava sem a correcao, porque o snap fazia o servico.
; (Foi o snap, alias, que produziu o poste no desenho do Renan.) O comando do
; produto tem que estar certo com o snap ligado E desligado; aqui se testa o
; caso em que o Z do clique chega cru.
;
; Sequencia do UFV_ALINHAMENTO: pontos, Enter para terminar, clique do lado,
; nome.

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_ALINHAMENTO" "{{P1}}" "{{P2}}" "{{P3}}" "" "{{LADO}}" "{{NOME}}")
(command "UFV_ALINHAMENTOS")
; A polilinha 3D guarda os vertices como entidades seguintes (entnext), ate
; o SEQEND. Le-se cada um e guarda-se a menor e a maior cota, e a contagem.
(setq ufv:e (entlast) ufv:v (entnext ufv:e) ufv:n 0 ufv:zmin 1e99 ufv:zmax -1e99)
(while (and ufv:v (= (cdr (assoc 0 (entget ufv:v))) "VERTEX"))
  (setq ufv:z (caddr (cdr (assoc 10 (entget ufv:v)))))
  (setq ufv:n (1+ ufv:n) ufv:zmin (min ufv:zmin ufv:z) ufv:zmax (max ufv:zmax ufv:z))
  (setq ufv:v (entnext ufv:v)))
(princ (strcat "
UFV_PONTAS"
               " tipo=" (cdr (assoc 0 (entget ufv:e)))
               " n=" (itoa ufv:n)
               " zmin=" (rtos ufv:zmin 2 3)
               " zmax=" (rtos ufv:zmax 2 3)
               " layer=" (cdr (assoc 8 (entget ufv:e)))))
(setvar "OSMODE" ufv:osmode)
(setq ufv:e (entget (entlast)))
(princ (strcat "\nUFV_PONTAS"
               " zA=" (rtos (caddr (cdr (assoc 10 ufv:e))) 2 3)
               " zB=" (rtos (caddr (cdr (assoc 11 ufv:e))) 2 3)
               " layer=" (cdr (assoc 8 ufv:e))))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
