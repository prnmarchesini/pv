; Teste de nivel 2 dos passos 1.3 e 1.4: lista as superficies do desenho e
; processa a primeira aproveitavel.
;
; O comando e o UFV_TERRENO_AUTO, e nao o UFV_TERRENO do produto. O do produto
; abre uma janela e espera o usuario confirmar; sem interface ele so lista, e
; e assim que tem que ser — teste nao pode ditar como o comando do usuario se
; comporta. O automatico existe so para o processamento ter como ser
; exercitado sem ninguem clicar.
;
; Sobre o SECURELOAD e a barra normal no caminho, ver ufv-ola.scr.

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
