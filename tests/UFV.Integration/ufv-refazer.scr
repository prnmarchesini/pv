; Teste de nivel 2 do Refazer: processa uma fileira (como no 5.8) e manda
; refazer a area inteira (UFV_REFAZER_AUTO). O que se confere em LISP:
;   - a fileira desenhada antes foi apagada, e nada ficou em dobro: os
;     pilares sao 7 por contorno e as faces 28 por contorno;
;   - toda nota (cota, aviso) tem XData com o GUID de uma mesa existente;
;   - o total de mesas e o da usina inteira (mais de uma fileira).

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area do refazer")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento do refazer")
(command "UFV_FILEIRA_AUTO")
(setvar "OSMODE" ufv:osmode)
(setq ufv:antes (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))))
(setq ufv:nantes (if ufv:antes (sslength ufv:antes) 0))
(command "UFV_REFAZER_AUTO")

(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))

(setq ufv:tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))))
(setq ufv:n (if ufv:tudo (sslength ufv:tudo) 0))
(setq ufv:contornos 0 ufv:pilares 0 ufv:faces 0 ufv:notas 0 ufv:notasorfas 0 ufv:guids nil ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:xd (ufv:xdata (ssname ufv:tudo ufv:i)) ufv:t (ufv:tipo ufv:xd))
  (cond ((= ufv:t "Mesa") (setq ufv:contornos (1+ ufv:contornos) ufv:guids (cons (ufv:campo ufv:xd 0) ufv:guids)))
        ((= ufv:t "Pilar") (setq ufv:pilares (1+ ufv:pilares)))
        ((= ufv:t "Face") (setq ufv:faces (1+ ufv:faces))))
  (setq ufv:i (1+ ufv:i)))
(setq ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:xd (ufv:xdata (ssname ufv:tudo ufv:i)))
  (if (= (ufv:tipo ufv:xd) "Nota")
    (progn (setq ufv:notas (1+ ufv:notas))
           (if (not (member (ufv:campo ufv:xd 1) ufv:guids)) (setq ufv:notasorfas (1+ ufv:notasorfas)))))
  (setq ufv:i (1+ ufv:i)))

(princ (strcat "\nUFV_REFAZER antes=" (itoa ufv:nantes) " contornos=" (itoa ufv:contornos) " pilares=" (itoa ufv:pilares)
               " faces=" (itoa ufv:faces) " notas=" (itoa ufv:notas) " notasorfas=" (itoa ufv:notasorfas)))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
