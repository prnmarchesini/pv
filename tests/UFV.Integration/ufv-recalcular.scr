; Teste de nivel 2 do 7.3/7.4: processa uma fileira, suja a primeira mesa
; (UFV_SUJAR_AUTO) e manda recalcular as sujas (UFV_RECALCULAR_AUTO). Le do
; desenho, pelo XData:
;   - o contorno com o MESMO GUID continua existindo, com suja=0;
;   - a mesa tem 7 pilares, 28 modulos e 28 faces (nada em dobro, nada
;     faltando) e nenhuma peca vermelha;
;   - o total de contornos nao mudou; UFV_ESTADO conta 0 sujas.

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area do recalcular")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento do recalcular")
(command "UFV_FILEIRA_AUTO")
(setvar "OSMODE" ufv:osmode)
(command "UFV_SUJAR_AUTO")

(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))
(defun ufv:vermelho (e) (if (or (= (cdr (assoc 420 (entget e))) 16711680) (= (cdr (assoc 62 (entget e))) 1)) 1 0))
(defun ufv:mesa (xd) (cond ((= (ufv:tipo xd) "Mesa") (ufv:campo xd 0)) ((= (ufv:tipo xd) "Face") (ufv:campo xd 2)) (T (ufv:campo xd 1))))

; ANTES: o GUID da mesa suja e a contagem de contornos.
(setq ufv:tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))))
(setq ufv:n (if ufv:tudo (sslength ufv:tudo) 0))
(setq ufv:guid nil ufv:antes 0 ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:xd (ufv:xdata (ssname ufv:tudo ufv:i)))
  (if (= (ufv:tipo ufv:xd) "Mesa")
    (progn (setq ufv:antes (1+ ufv:antes)) (if (= (ufv:campo ufv:xd 7) "1") (setq ufv:guid (ufv:campo ufv:xd 0)))))
  (setq ufv:i (1+ ufv:i)))

(command "UFV_RECALCULAR_AUTO")
(command "UFV_ESTADO")

; DEPOIS: a mesa do MESMO GUID, limpa, com 7 pilares, 28 modulos, 28 faces e nada vermelho.
(setq ufv:tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))))
(setq ufv:n (if ufv:tudo (sslength ufv:tudo) 0))
(setq ufv:contornos 0 ufv:cont 0 ufv:suja "-" ufv:pil 0 ufv:mod 0 ufv:fac 0 ufv:verm 0 ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:en (ssname ufv:tudo ufv:i) ufv:xd (ufv:xdata ufv:en) ufv:t (ufv:tipo ufv:xd))
  (if (= ufv:t "Mesa") (setq ufv:contornos (1+ ufv:contornos)))
  (if (and ufv:guid (= (ufv:mesa ufv:xd) ufv:guid))
    (cond ((= ufv:t "Mesa") (setq ufv:cont (1+ ufv:cont) ufv:suja (ufv:campo ufv:xd 7) ufv:verm (+ ufv:verm (ufv:vermelho ufv:en))))
          ((= ufv:t "Pilar") (setq ufv:pil (1+ ufv:pil) ufv:verm (+ ufv:verm (ufv:vermelho ufv:en))))
          ((= ufv:t "Modulo") (setq ufv:mod (1+ ufv:mod) ufv:verm (+ ufv:verm (ufv:vermelho ufv:en))))
          ((= ufv:t "Face") (setq ufv:fac (1+ ufv:fac)))))
  (setq ufv:i (1+ ufv:i)))
(princ (strcat "\nUFV_RECALC_LISP antes=" (itoa ufv:antes) " contornos=" (itoa ufv:contornos) " guid=" (if ufv:guid ufv:guid "-")
               " cont=" (itoa ufv:cont) " suja=" ufv:suja " pilares=" (itoa ufv:pil) " modulos=" (itoa ufv:mod) " faces=" (itoa ufv:fac) " vermelhas=" (itoa ufv:verm)))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
