; Teste de nivel 2 do Apagar tudo (29/09/2026): cria a camada da area
; branca (como nos desenhos de antes), traca area e alinhamento, processa
; uma fileira, poe todas as mesas num grupo e manda apagar tudo da area
; (UFV_APAGAR_TUDO_AUTO). O que se confere em LISP:
;   - nada do plugin sobrou alem da area e do alinhamento (uma de cada);
;   - a marca do grupo sumiu com ele;
;   - a camada da area ficou laranja (ACI 30), mesmo tendo nascido branca,
;     e a do alinhamento amarela (ACI 2).

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.-LAYER" "_N" "MARCHENG_UFV_AREA" "")
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area do apagar")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento do apagar")
(command "UFV_FILEIRA_AUTO")
(setvar "OSMODE" ufv:osmode)

(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))
(defun ufv:contar ( / tudo n i tp areas alins outras)
  (setq tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))) n (if tudo (sslength tudo) 0) i 0 areas 0 alins 0 outras 0)
  (while (< i n)
    (setq tp (ufv:tipo (ufv:xdata (ssname tudo i))))
    (cond ((= tp "Area") (setq areas (1+ areas)))
          ((= tp "Alinhamento") (setq alins (1+ alins)))
          (T (setq outras (1+ outras))))
    (setq i (1+ i)))
  (list areas alins outras))
(defun ufv:marcas ( / ss) (setq ss (ssget "_X" (list (cons 8 "MARCHENG_UFV_GRUPO")))) (if ss (sslength ss) 0))
(defun ufv:cor (camada) (cdr (assoc 62 (tblsearch "LAYER" camada))))

; Todas as pecas de mesa num grupo.
(setq ufv:tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))) ufv:ss (ssadd) ufv:i 0)
(while (< ufv:i (sslength ufv:tudo))
  (setq ufv:en (ssname ufv:tudo ufv:i) ufv:t (ufv:tipo (ufv:xdata ufv:en)))
  (if (not (member ufv:t '("Area" "Alinhamento"))) (ssadd ufv:en ufv:ss))
  (setq ufv:i (1+ ufv:i)))
(sssetfirst nil ufv:ss)
(command "UFV_GRUPO_CRIAR" "Grupo do apagar")
(sssetfirst nil nil)
(setq ufv:antes (ufv:contar) ufv:marcasAntes (ufv:marcas))

(command "UFV_APAGAR_TUDO_AUTO")
(command "UFV_GRUPOS")

(setq ufv:depois (ufv:contar) ufv:marcasDepois (ufv:marcas))
(princ (strcat "\nUFV_APAGAR_LISP antes=" (itoa (nth 2 ufv:antes)) " marcasAntes=" (itoa ufv:marcasAntes)
               " areas=" (itoa (nth 0 ufv:depois)) " alinhamentos=" (itoa (nth 1 ufv:depois))
               " sobrou=" (itoa (nth 2 ufv:depois)) " marcas=" (itoa ufv:marcasDepois)
               " corArea=" (itoa (ufv:cor "MARCHENG_UFV_AREA")) " corAlinhamento=" (itoa (ufv:cor "MARCHENG_UFV_ALINHAMENTO"))))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
