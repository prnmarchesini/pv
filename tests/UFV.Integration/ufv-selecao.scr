; Teste de nivel 2 do 7.8: processa uma fileira, poe na selecao previa
; (sssetfirst) todas as entidades de duas mesas e um pilar so de uma
; terceira, e manda UFV_KWP_SELECAO: tem que dizer 3 mesas, 84 modulos e
; 60,5 kWp (28 x 3 x 720 W: a mesa entra inteira mesmo que so um pilar dela
; esteja selecionado). Sem selecao nossa, diz que nao ha mesa.
(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area da selecao")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento da selecao")
(command "UFV_FILEIRA_AUTO")
(setvar "OSMODE" ufv:osmode)
(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))
(defun ufv:mesa (xd) (cond ((= (ufv:tipo xd) "Mesa") (ufv:campo xd 0)) ((= (ufv:tipo xd) "Face") (ufv:campo xd 2)) (T (ufv:campo xd 1))))
(setq ufv:tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))))
(setq ufv:n (if ufv:tudo (sslength ufv:tudo) 0))
(setq ufv:g1 nil ufv:g2 nil ufv:g3 nil ufv:vistos 0 ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:xd (ufv:xdata (ssname ufv:tudo ufv:i)))
  (if (= (ufv:tipo ufv:xd) "Mesa")
    (progn (setq ufv:vistos (1+ ufv:vistos))
           (if (= ufv:vistos 1) (setq ufv:g1 (ufv:campo ufv:xd 0)))
           (if (= ufv:vistos 2) (setq ufv:g2 (ufv:campo ufv:xd 0)))
           (if (= ufv:vistos 3) (setq ufv:g3 (ufv:campo ufv:xd 0)))))
  (setq ufv:i (1+ ufv:i)))
(setq ufv:ss (ssadd) ufv:pilar3 nil ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:en (ssname ufv:tudo ufv:i) ufv:xd (ufv:xdata ufv:en) ufv:m (ufv:mesa ufv:xd))
  (if (or (= ufv:m ufv:g1) (= ufv:m ufv:g2)) (ssadd ufv:en ufv:ss))
  (if (and (not ufv:pilar3) (= ufv:m ufv:g3) (= (ufv:tipo ufv:xd) "Pilar")) (setq ufv:pilar3 ufv:en))
  (setq ufv:i (1+ ufv:i)))
(ssadd ufv:pilar3 ufv:ss)
(princ (strcat "\nUFV_SELECAO_LISP selecionadas=" (itoa (sslength ufv:ss))))
(sssetfirst nil ufv:ss)
(command "UFV_KWP_SELECAO")
; Sem selecao nossa: uma linha qualquer.
(command "_.LINE" "0,0,0" "10,0,0" "")
(setq ufv:linha (entlast))
(setq ufv:ssl (ssadd ufv:linha))
(sssetfirst nil ufv:ssl)
(command "UFV_KWP_SELECAO")
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
