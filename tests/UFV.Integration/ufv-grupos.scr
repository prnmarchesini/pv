; Teste de nivel 2 do 7.9: processa uma fileira, cria o grupo "Bloco A"
; com as mesas F1.1 e F1.2 (pela selecao previa), lista os grupos (2
; mesas, 56 modulos, 14 pilares, 40,3 kWp), suja a F1.1 e recalcula o
; grupo (2 de 2, e ESTADO sem suja), seleciona o grupo (as entidades das
; duas mesas, contadas depois do recalcular), apaga a F1.1 (a lista diz
; que 1 nao esta mais no desenho e selecionar da so a F1.2) e apaga o
; registro do grupo pelo nome em minusculas (as mesas ficam).
(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area dos grupos")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento dos grupos")
(command "UFV_FILEIRA_AUTO")
(setvar "OSMODE" ufv:osmode)
(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))
(defun ufv:tipo (xd) (cdr (nth 0 xd)))
(defun ufv:mesa (xd) (cond ((= (ufv:tipo xd) "Mesa") (ufv:campo xd 0)) ((= (ufv:tipo xd) "Face") (ufv:campo xd 2)) (T (ufv:campo xd 1))))
(setq ufv:tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))))
(setq ufv:n (if ufv:tudo (sslength ufv:tudo) 0))
(setq ufv:g1 nil ufv:g2 nil ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:xd (ufv:xdata (ssname ufv:tudo ufv:i)))
  (if (= (ufv:tipo ufv:xd) "Mesa")
    (progn (if (= (ufv:campo ufv:xd 1) "F1.1") (setq ufv:g1 (ufv:campo ufv:xd 0)))
           (if (= (ufv:campo ufv:xd 1) "F1.2") (setq ufv:g2 (ufv:campo ufv:xd 0)))))
  (setq ufv:i (1+ ufv:i)))
(setq ufv:ss (ssadd) ufv:i 0)
(while (< ufv:i ufv:n)
  (setq ufv:en (ssname ufv:tudo ufv:i) ufv:m (ufv:mesa (ufv:xdata ufv:en)))
  (if (or (= ufv:m ufv:g1) (= ufv:m ufv:g2)) (ssadd ufv:en ufv:ss))
  (setq ufv:i (1+ ufv:i)))
(defun ufv:pecas (g / tudo n i ss en)
  (setq tudo (ssget "_X" (list (cons -3 (list (list "MARCHENG_UFV"))))) ss (ssadd) i 0 n (if tudo (sslength tudo) 0))
  (while (< i n)
    (setq en (ssname tudo i))
    (if (= (ufv:mesa (ufv:xdata en)) g) (ssadd en ss))
    (setq i (1+ i)))
  ss)
(defun ufv:marcas ( / ss) (setq ss (ssget "_X" (list (cons 8 "MARCHENG_UFV_GRUPO") (cons -3 (list (list "MARCHENG_UFV")))))) (if ss (sslength ss) 0))
(sssetfirst nil ufv:ss)
(command "UFV_GRUPO_CRIAR" "Bloco A")
(setq ufv:marcaCriada (ufv:marcas))
(command "UFV_GRUPOS")
(command "UFV_SUJAR_AUTO")
(command "UFV_GRUPO_RECALCULAR" "Bloco A")
(command "UFV_ESTADO")
(setq ufv:depois (+ (sslength (ufv:pecas ufv:g1)) (sslength (ufv:pecas ufv:g2))))
(command "UFV_GRUPO_SELECIONAR" "Bloco A")
(setq ufv:so2 (sslength (ufv:pecas ufv:g2)))
(command "_.ERASE" (ufv:pecas ufv:g1) "")
(command "UFV_GRUPOS")
(command "UFV_GRUPO_SELECIONAR" "Bloco A")
(command "UFV_GRUPO_APAGAR" "bloco a")
(setq ufv:marcaApagada (ufv:marcas))
(command "UFV_GRUPOS")
(princ (strcat "\nUFV_GRUPOS_LISP mesas=" (itoa ufv:depois) " so2=" (itoa ufv:so2) " marca=" (itoa ufv:marcaCriada) " marcaApagada=" (itoa ufv:marcaApagada)))
(setvar "SECURELOAD" ufv:secureload)
(princ (strcat "\nUFV_SECURELOAD_ANTES=" (itoa ufv:secureload) " DEPOIS=" (itoa (getvar "SECURELOAD"))))
(princ)
