; Teste de nivel 2 da usina com dois tipos de mesa (passos 8.5 e 8.6): as
; mesas de 28 e de 14 modulos ficam no desenho, em uso; a usina e gerada
; numa area de 90 m de largura (cabem 4 de 28 e 1 de 14 por fileira). Em
; LISP: quantos contornos de cada perfil (o nome gravado no XData da mesa,
; campo 15), quantos pilares e faces, a cota dos pilares (regra 5).

(setq ufv:secureload (getvar "SECURELOAD"))
(setvar "SECURELOAD" 0)
(command "_.NETLOAD" "{{DLL}}")
(command "UFV_TERRENO_AUTO")
(setq ufv:osmode (getvar "OSMODE"))
(setvar "OSMODE" 0)
(command "UFV_AREA" "{{A1}}" "{{A2}}" "{{A3}}" "{{A4}}" "" "Area mista")
(command "UFV_ALINHAMENTO" "{{L1}}" "{{L2}}" "" "{{LADO}}" "Alinhamento misto")
(command "UFV_MESAS_EXEMPLO_AUTO")
(command "UFV_USINA_AUTO")
(setvar "OSMODE" ufv:osmode)

(defun ufv:conta (ss) (if ss (sslength ss) 0))
(defun ufv:xdata (e) (cdr (car (cdr (assoc -3 (entget e '("MARCHENG_UFV")))))))
(defun ufv:campo (xd k) (cdr (nth (+ 2 k) xd)))

(setq ufv:ss (ssget "_X" (list (cons 0 "POLYLINE") (list -3 (list "MARCHENG_UFV")))) ufv:i 0 ufv:n28 0 ufv:n14 0 ufv:outros 0 ufv:cor 0)
(while (< ufv:i (ufv:conta ufv:ss))
  (setq ufv:e (ssname ufv:ss ufv:i) ufv:xd (ufv:xdata ufv:e))
  (if (= (cdr (nth 0 ufv:xd)) "Mesa")
    (progn
      (cond ((= (ufv:campo ufv:xd 15) "Mesa 2V28") (setq ufv:n28 (1+ ufv:n28)))
            ((= (ufv:campo ufv:xd 15) "Mesa 2V14") (setq ufv:n14 (1+ ufv:n14)))
            (T (setq ufv:outros (1+ ufv:outros))))
      (if (assoc 420 (entget ufv:e)) (setq ufv:cor (1+ ufv:cor)))))
  (setq ufv:i (1+ ufv:i)))

(setq ufv:pilares (ssget "_X" (list (cons 0 "INSERT") (cons 2 "MARCHENG_UFV_PILAR"))))
(setq ufv:np (ufv:conta ufv:pilares) ufv:nf (ufv:conta (ssget "_X" (list (cons 0 "3DFACE") (cons 8 "MARCHENG_UFV_FACE")))))
(setq ufv:i 0 ufv:zmin 1e99 ufv:zmax -1e99)
(while (< ufv:i ufv:np)
  (setq ufv:z (cadddr (assoc 10 (entget (ssname ufv:pilares ufv:i)))))
  (setq ufv:zmin (min ufv:zmin ufv:z) ufv:zmax (max ufv:zmax ufv:z) ufv:i (1+ ufv:i)))

(princ (strcat "\nUFV_MISTA n28=" (itoa ufv:n28) " n14=" (itoa ufv:n14) " outros=" (itoa ufv:outros) " comcor=" (itoa ufv:cor)
               " pilares=" (itoa ufv:np) " faces=" (itoa ufv:nf) " zmin=" (rtos ufv:zmin 2 3) " zmax=" (rtos ufv:zmax 2 3)))
(setvar "SECURELOAD" ufv:secureload)
(princ)
