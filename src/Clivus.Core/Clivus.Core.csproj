<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ForTesting de TableGeometry so e visivel aos testes: montar geometria sem
    validacao e legitimo para provar que um verificador recusa mesa torta, e
    ilegitimo em qualquer outro lugar.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Clivus.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clivus.Geo\Clivus.Geo.csproj" />
  </ItemGroup>

  <!--
    A biblioteca de modulos viaja dentro da DLL. Como arquivo solto ao lado do
    plugin ela sumiria na primeira instalacao que copiasse so a DLL, e a lista
    apareceria vazia sem explicacao.
  -->
  <ItemGroup>
    <EmbeddedResource Include="modulos.json" />
    <EmbeddedResource Include="municipios.csv" />
    <EmbeddedResource Include="Translations/en.json" LogicalName="Clivus.Core.Translations.en.json" />
    <EmbeddedResource Include="Translations/es.json" LogicalName="Clivus.Core.Translations.es.json" />
    <!-- A three.js (MIT) da página 3D do passo 9.9: a página sai num arquivo só, sem internet. -->
    <EmbeddedResource Include="Visualizador3D/three.min.js" LogicalName="Clivus.Core.three.min.js" />
    <EmbeddedResource Include="Visualizador3D\OrbitControls.js" LogicalName="Clivus.Core.OrbitControls.js" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
