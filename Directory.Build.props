<Project>

  <PropertyGroup>
    <!--
      Versao do plugin: a unica fonte (etapa 43). Dela saem o CLIVUS_OLA e o
      Sobre, a versao que a atualizacao compara com a publicada no servidor, o
      PackageContents.xml do bundle (carimbado no build), a versao do
      instalador e o nome do ClivusSolar-Setup-<versao>.exe. Para subir: mude
      aqui e rode tools\gerar-instalador.ps1.
    -->
    <Version>0.1.10</Version>
    <Company>Clivus Solar</Company>
    <Product>Clivus Solar</Product>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Raiz da instalacao do AutoCAD Civil 3D 2026.
    Sobrescreva na linha de comando se estiver em outro caminho:
      dotnet build -p:Civil3DPath="D:\Autodesk\AutoCAD 2026\"
  -->
  <PropertyGroup>
    <Civil3DPath Condition="'$(Civil3DPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2026\</Civil3DPath>
  </PropertyGroup>

</Project>
